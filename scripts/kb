#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml>=6", "numpy>=1.26", "model2vec>=0.4"]
# ///
"""kb — deterministic primitives for Gregor's knowledge base.

The LLM layer (slash commands, skills) calls these instead of traversing or
bookkeeping by hand. Everything mechanical lives here; judgment stays with the
model.

Subcommands:
  index            build/refresh the search index: FTS5 + local embeddings (incremental, by mtime)
  search QUERY     hybrid-ranked (BM25 ∪ vector, RRF) search over the DISTILLED fields
                   (title/topics/summary/decisions/steps/statement). Transcript bodies are
                   deliberately not indexed — they are HOT-tier payload for kb-researcher
  file             write a leaf deterministically from an LLM-distilled JSON payload
                   (+ machine-rendered transcript), validate, sync, report same-topic
                   models/recipes. --jot: no transcript. The LLM judges; this writes.
  transcript PATH  render a Claude Code session JSONL as a condensed, faithful transcript
  facts [SUBJECT]  the claim layer: current value per (subject, scope), exceptions, history,
                   --as-of DATE; claims live in episode frontmatter, the view is derived
  subjects         the subject vocabulary (_subjects.yaml): keys, aliases, decay class, counts
  check            (text on stdin) the KB's current claims on every subject the text touches —
                   the LLM compares and reports contradictions with since/source
  eval             retrieval-quality metrics (MRR/recall) over the _eval.yaml gold set
  show ID|URI|PATH resolve an entry and print it (--path: print the path only)
  edges ID         resolved typed edges, forward AND reverse ("what links here")
  routes           emit the route layer (+ BASELINE metrics); --compact / --deep
  reindex-routes   regenerate entries[]/subroutes/last_indexed in every _route.md
                   from the leaves (purpose/related/prose stay hand-curated)
  sync             reindex-routes + audit-topics --fix + index  (post-filing one-liner)
  doctor           staleness + referential-integrity report
  problems         the epistemic ledger: scan | list | brief | resolve | drop

The index lives at $KB_DATA_DIR/.index/kb.db (gitignored, disposable — rebuilt
from the markdown at any time). KB_INDEX_DB=<path> points at an alternative db
(isolated retrieval experiments: build a variant, run `kb eval`, compare);
KB_EMBED_MODEL overrides the embedding model the same way.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

import yaml


# --------------------------------------------------------------------- paths

def kb_root() -> Path:
    root = os.environ.get("KB_DATA_DIR") or str(
        Path(__file__).resolve().parent.parent / "kb-data")
    p = Path(root)
    if not p.exists():
        sys.exit(f"kb: KB_DATA_DIR does not exist: {p}")
    return p


def engine_dir() -> Path:
    return Path(__file__).resolve().parent.parent


def db_path(root: Path) -> Path:
    d = root / ".index"
    d.mkdir(exist_ok=True)
    return Path(os.environ["KB_INDEX_DB"]) if os.environ.get("KB_INDEX_DB") else d / "kb.db"


def to_kb_uri(root: Path, p: Path) -> str:
    return "kb:/" if p == root else "kb:/" + str(p.relative_to(root))


def from_kb_uri(root: Path, uri: str) -> Path:
    rel = uri[len("kb:/"):]
    return root if rel == "" else root / rel


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --------------------------------------------------------------- frontmatter

class StrLoader(yaml.SafeLoader):
    """SafeLoader that keeps ISO timestamps as strings."""


StrLoader.yaml_implicit_resolvers = {
    k: [(tag, rx) for (tag, rx) in resolvers if tag != "tag:yaml.org,2002:timestamp"]
    for k, resolvers in StrLoader.yaml_implicit_resolvers.items()
}


def parse_fm(path: Path) -> tuple[dict | None, str]:
    """Return (frontmatter dict or None, body text)."""
    try:
        text = path.read_text()
    except Exception:
        return None, ""
    if not text.startswith("---\n"):
        return None, text
    try:
        end = text.index("\n---\n", 4)
    except ValueError:
        return None, text
    try:
        fm = yaml.load(text[4:end], Loader=StrLoader)
    except yaml.YAMLError:
        return None, text
    if not isinstance(fm, dict):
        return None, text
    return fm, text[end + 5:]


def _hidden(root: Path, p: Path) -> bool:
    return any(part.startswith(".") for part in p.relative_to(root).parts)


def walk_md(root: Path):
    for p in sorted(root.rglob("*.md")):
        if not _hidden(root, p):
            yield p


def walk_txt(root: Path):
    """Sidecar .txt artifacts (interview feedback, question sheets, …) — indexed
    as doctype 'attachment' so their content is searchable, but excluded from
    routes, doctor, and the ambient index. `_`-prefixed files are config."""
    for p in sorted(root.rglob("*.txt")):
        if not _hidden(root, p) and not p.name.startswith("_"):
            yield p


def first_line(s: object, limit: int = 200) -> str:
    """First paragraph, collapsed to one line, truncated."""
    if not isinstance(s, str) or not s.strip():
        return ""
    para = s.strip().split("\n\n")[0]
    line = " ".join(part.strip() for part in para.splitlines())
    return line if len(line) <= limit else line[: limit - 1] + "…"


# --------------------------------------------------------------------- index

# Bump SCHEMA_VERSION whenever the FTS shape or tokenizer changes: the index is
# documented-disposable, so a mismatch just drops and rebuilds it transparently.
SCHEMA_VERSION = "4"  # 4: claims table + claim docs

SCHEMA = """
CREATE TABLE IF NOT EXISTS meta (
  path TEXT PRIMARY KEY,        -- kb:/ URI
  mtime REAL NOT NULL,
  id TEXT,
  doctype TEXT NOT NULL,        -- entry | recipe | model | problem | route | attachment
  status TEXT,
  title TEXT,
  created TEXT,
  updated TEXT,
  topics TEXT,                  -- comma-joined
  participants TEXT
);
CREATE VIRTUAL TABLE IF NOT EXISTS docs USING fts5(
  id, title, topics, participants, summary, extra, body, path UNINDEXED,
  tokenize = 'porter unicode61'
);
CREATE TABLE IF NOT EXISTS edges (
  src TEXT NOT NULL,            -- source id
  kind TEXT NOT NULL,           -- related|supersedes|superseded_by|contradicts|derived_from|evidence_for|refuted_by|rivals|models
  target TEXT NOT NULL,         -- bare id, or kb:/ URI for related
  PRIMARY KEY (src, kind, target)
);
CREATE INDEX IF NOT EXISTS idx_edges_target ON edges(target);
CREATE TABLE IF NOT EXISTS vectors (
  path TEXT NOT NULL,           -- kb:/ URI
  kind TEXT NOT NULL,           -- 'head' | 'chunk:N'
  dim INTEGER NOT NULL,
  vec BLOB NOT NULL,            -- float32, L2-normalized at write time
  PRIMARY KEY (path, kind)
);
CREATE TABLE IF NOT EXISTS claims (
  path TEXT PRIMARY KEY,        -- claim:<episode-id>:<n>
  episode TEXT NOT NULL,        -- asserting episode id
  subject TEXT NOT NULL,        -- dotted key from _subjects.yaml
  scope TEXT NOT NULL,          -- canonical 'k=v;k=v' ('' = default)
  value TEXT NOT NULL,
  value_norm TEXT NOT NULL,
  since TEXT NOT NULL,          -- YYYY-MM-DD the value became true
  kind TEXT NOT NULL,           -- observed | inferred | reported
  source TEXT,
  asserted TEXT NOT NULL,       -- episode created (bi-temporal: when we learned it)
  valid_to TEXT,                -- set by supersession (derived, never hand-written)
  superseded_by TEXT,           -- claim path
  confirmed TEXT                -- latest later same-value assertion (derived)
);
CREATE INDEX IF NOT EXISTS idx_claims_key ON claims(subject, scope);
CREATE TABLE IF NOT EXISTS kv (k TEXT PRIMARY KEY, v TEXT);
"""


def open_db(root: Path) -> sqlite3.Connection:
    con = sqlite3.connect(db_path(root))
    con.execute("CREATE TABLE IF NOT EXISTS kv (k TEXT PRIMARY KEY, v TEXT)")
    row = con.execute("SELECT v FROM kv WHERE k = 'schema_version'").fetchone()
    if row is None or row[0] != SCHEMA_VERSION:
        # disposable by contract — drop and let the caller repopulate
        for t in ("docs", "meta", "edges", "vectors", "claims"):
            con.execute(f"DROP TABLE IF EXISTS {t}")
        con.execute("INSERT OR REPLACE INTO kv VALUES ('schema_version', ?)",
                    (SCHEMA_VERSION,))
    con.executescript(SCHEMA)
    con.commit()
    return con


def doc_fields(fm: dict, body: str, doctype: str) -> dict:
    """Flatten frontmatter into the FTS columns."""
    lst = lambda k: [str(x) for x in (fm.get(k) or []) if x is not None]
    extra_parts: list[str] = []
    for k in ("when_to_use", "purpose", "statement"):
        if isinstance(fm.get(k), str):
            extra_parts.append(fm[k])
    for k in ("steps", "decisions", "open_questions", "tools", "inputs", "predictions"):
        extra_parts.extend(lst(k))
    if doctype == "problem":
        extra_parts.append(str(fm.get("kind") or ""))
        extra_parts.append(str(fm.get("resolution") or ""))
        exp = fm.get("experiment")
        if isinstance(exp, dict):
            extra_parts.append(str(exp.get("observation") or ""))
            extra_parts.append(str(exp.get("where") or ""))
            for o in exp.get("outcomes") or []:
                if isinstance(o, dict):
                    extra_parts.append(f"{o.get('if') or ''} -> {o.get('then') or ''}")
    if doctype == "route":
        for sub in fm.get("subroutes") or []:
            if isinstance(sub, dict):
                extra_parts.append(str(sub.get("summary") or ""))
        for ent in fm.get("entries") or []:
            if isinstance(ent, dict):
                extra_parts.append(str(ent.get("summary") or ""))
    return {
        "id": str(fm.get("id") or ""),
        "title": str(fm.get("title") or ""),
        "topics": ", ".join(lst("topics")),
        "participants": ", ".join(lst("participants")),
        "summary": str(fm.get("summary") or ""),
        "extra": "\n".join(p for p in extra_parts if p),
        "body": body,
    }


# ------------------------------------------------------------------- claims
#
# A claim is a decision with a key: "subject X currently has value V (in scope
# S), since D". Claims live in the asserting episode's frontmatter (`claims:`),
# so provenance is free and episodes stay immutable. Everything else — which
# claim is current, what superseded what, what was re-confirmed, what is stale
# — is DERIVED here from the (subject, scope) key and dates. No similarity, no
# LLM: same key + later `since` + different value = supersession; same value =
# confirmation. Scope resolution: the most specific matching scope wins, the
# unscoped claim is the default.

CLAIM_KINDS = ("observed", "inferred", "reported")
SUBJECT_RE = re.compile(r"^[a-z0-9]+(\.[a-z0-9][a-z0-9-]*)+$")


def norm_value(v: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", str(v).lower()).strip()


# Two claims on one key can differ in words while stating the same fact — a
# terser restatement, or the same thing described from another episode. That is
# a confirmation, not a contradiction. Content-word containment separates the
# two cheaply: a restatement repeats most of the shorter claim's vocabulary, a
# real disagreement ("BM25" vs "dense cosine") does not.
RESTATEMENT_MIN = 0.7


def is_restatement(a: str, b: str) -> bool:
    wa = {w for w in a.split() if len(w) > 2}
    wb = {w for w in b.split() if len(w) > 2}
    if not wa or not wb:
        return a == b
    return len(wa & wb) / min(len(wa), len(wb)) >= RESTATEMENT_MIN


def scope_key(scope: object) -> str:
    """Canonical scope string: 'k=v;k=v', list values sorted and |-joined."""
    if not isinstance(scope, dict) or not scope:
        return ""
    parts = []
    for k in sorted(scope):
        v = scope[k]
        vs = "|".join(sorted(str(x) for x in v)) if isinstance(v, list) else str(v)
        parts.append(f"{k}={vs}")
    return ";".join(parts)


def parse_scope(s: str) -> dict[str, set[str]]:
    out: dict[str, set[str]] = {}
    for part in filter(None, s.split(";")):
        k, _, v = part.partition("=")
        out[k] = set(v.split("|"))
    return out


def scope_matches(claim_scope: str, want: dict[str, str]) -> bool:
    """A claim applies to `want` when every scope dimension it fixes is satisfied."""
    for k, vals in parse_scope(claim_scope).items():
        if k not in want or want[k] not in vals:
            return False
    return True


def episode_claims(fm: dict) -> list[dict]:
    """Normalize the `claims:` list of one episode; invalid items are skipped
    (the validator reports them — the index never guesses)."""
    out = []
    eid = str(fm.get("id") or "")
    default_since = str(fm.get("created") or "")[:10]
    for n, c in enumerate(fm.get("claims") or [], start=1):
        if not isinstance(c, dict):
            continue
        subject = str(c.get("subject") or "").strip().lower()
        value = str(c.get("value") or "").strip()
        if not SUBJECT_RE.match(subject) or not value:
            continue
        since = str(c.get("since") or default_since)[:10]
        kind = str(c.get("kind") or "observed")
        if kind not in CLAIM_KINDS:
            kind = "observed"
        out.append({"path": f"claim:{eid}:{n}", "episode": eid, "subject": subject,
                    "scope": scope_key(c.get("scope")), "value": value,
                    "value_norm": norm_value(value), "since": since, "kind": kind,
                    "source": str(c["source"]) if c.get("source") else None,
                    "asserted": str(fm.get("created") or "")})
    return out


def index_claims(con: sqlite3.Connection, fm: dict, uri: str, mtime: float) -> list[tuple[str, str]]:
    """Replace this episode's claim rows + claim docs. Returns (path, head) pairs
    for embedding. Supersession is recomputed globally afterwards (derive_claims)."""
    eid = str(fm.get("id") or "")
    if not eid:
        return []
    old = [r[0] for r in con.execute("SELECT path FROM claims WHERE episode = ?", (eid,))]
    for cpath in old:
        con.execute("DELETE FROM claims WHERE path = ?", (cpath,))
        con.execute("DELETE FROM docs WHERE path = ?", (cpath,))
        con.execute("DELETE FROM meta WHERE path = ?", (cpath,))
        con.execute("DELETE FROM vectors WHERE path = ?", (cpath,))
    pending = []
    for c in episode_claims(fm):
        con.execute(
            "INSERT INTO claims (path,episode,subject,scope,value,value_norm,since,kind,"
            "source,asserted) VALUES (?,?,?,?,?,?,?,?,?,?)",
            (c["path"], eid, c["subject"], c["scope"], c["value"], c["value_norm"],
             c["since"], c["kind"], c["source"], c["asserted"]))
        title = f"{c['subject']}" + (f" [{c['scope']}]" if c["scope"] else "") + f" = {c['value']}"
        head = f"{c['subject'].replace('.', ' ')} {c['value']}"
        con.execute(
            "INSERT INTO docs (id,title,topics,participants,summary,extra,body,path) "
            "VALUES (?,?,?,?,?,?,?,?)",
            (f"{eid}#{c['path'].rsplit(':', 1)[1]}", title, "", "", c["value"],
             c["subject"].replace(".", " ") + " " + c["scope"].replace("=", " "), "", c["path"]))
        con.execute(
            "INSERT OR REPLACE INTO meta VALUES (?,?,?,?,?,?,?,?,?,?)",
            (c["path"], mtime, f"{eid}#{c['path'].rsplit(':', 1)[1]}", "claim", "active",
             title, c["asserted"], c["asserted"], "", ""))
        pending.append((c["path"], head))
    return pending


def derive_claims(con: sqlite3.Connection) -> None:
    """Global pass: for each (subject, scope) key order claims by since, then
    asserted; a later different value supersedes, a later same value confirms."""
    con.execute("UPDATE claims SET valid_to = NULL, superseded_by = NULL, confirmed = NULL")
    rows = con.execute("SELECT path, subject, scope, value_norm, since, asserted FROM claims "
                       "ORDER BY subject, scope, since, asserted").fetchall()
    by_key: dict[tuple[str, str], list] = {}
    for r in rows:
        by_key.setdefault((r[1], r[2]), []).append(r)
    for key, chain in by_key.items():
        current = None  # (path, value_norm, since)
        for path, _s, _sc, vnorm, since, asserted in chain:
            if current is None:
                current = (path, vnorm, since)
                continue
            cpath, cnorm, csince = current
            if vnorm == cnorm or is_restatement(vnorm, cnorm):
                # confirmation: the standing claim's clock resets. Keep whichever
                # statement is more specific (longer), fold the other into it.
                keep, fold = ((path, vnorm, since), (cpath, cnorm, csince)) \
                    if len(vnorm) > len(cnorm) else ((cpath, cnorm, csince), (path, vnorm, since))
                con.execute("UPDATE claims SET confirmed = ?, valid_to = NULL, "
                            "superseded_by = NULL WHERE path = ?", (since, keep[0]))
                con.execute("UPDATE claims SET valid_to = ?, superseded_by = ? WHERE path = ?",
                            (fold[2], keep[0], fold[0]))
                current = keep
            else:
                con.execute("UPDATE claims SET valid_to = ?, superseded_by = ? WHERE path = ?",
                            (since, path, cpath))
                current = (path, vnorm, since)
    # visibility: superseded claims leave the default search/recall pool
    con.execute("UPDATE meta SET status = CASE WHEN (SELECT valid_to FROM claims WHERE "
                "claims.path = meta.path) IS NULL THEN 'active' ELSE 'superseded' END "
                "WHERE doctype = 'claim'")


def load_subjects(root: Path) -> dict:
    p = root / "_subjects.yaml"
    if not p.is_file():
        return {"subjects": {}, "decay": {}, "defaults": {}}
    data = yaml.load(p.read_text(), Loader=StrLoader) or {}
    data.setdefault("subjects", {}); data.setdefault("decay", {}); data.setdefault("defaults", {})
    data["subjects"] = data["subjects"] or {}
    return data


def subject_decay_days(vocab: dict, subject: str) -> int | None:
    """Half-life in days after which an unconfirmed claim is stale; None = never."""
    entry = (vocab["subjects"].get(subject) or {}) if isinstance(vocab["subjects"], dict) else {}
    cls = entry.get("decay") if isinstance(entry, dict) else None
    if not cls:
        cls = (vocab.get("defaults") or {}).get(subject.split(".")[0], "topology")
    days = (vocab.get("decay") or {}).get(cls, 180)
    return None if not days else int(days)


def register_subjects(root: Path, con: sqlite3.Connection) -> list[str]:
    """Every subject used by a claim exists in _subjects.yaml (auto-stubbed, like
    route entries[]); aliases/decay stay hand-curated. Returns newly minted keys."""
    vocab = load_subjects(root)
    used = [r[0] for r in con.execute("SELECT DISTINCT subject FROM claims ORDER BY subject")]
    new = [s for s in used if s not in vocab["subjects"]]
    if not new:
        return []
    p = root / "_subjects.yaml"
    text = p.read_text() if p.is_file() else SUBJECTS_TEMPLATE
    if "subjects:" not in text:
        text = text.rstrip() + "\nsubjects:\n"
    block = "".join(f"  {s}:\n    aliases: []\n" for s in new)
    # append under the subjects: mapping (it is the last top-level key by convention)
    text = text.rstrip() + "\n" + block
    p.write_text(text)
    return new


SUBJECTS_TEMPLATE = """# Subject vocabulary for claims (`claims:` in episode frontmatter).
#
# A subject is a dotted key naming ONE thing that has a current value:
#   <area>.<thing>.<attribute>   e.g. mt.nn-retrieval.similarity
# `kb sync` auto-appends any subject a claim uses (stub, no aliases). You curate:
#   aliases: words/phrases that mean this subject in prose (kb check / recall match on them)
#   decay:   how fast an unconfirmed claim on it goes stale (class name from `decay:` below)
# Areas: pick from an existing top-level prefix before inventing one.
decay:            # class -> days until an unconfirmed claim is reported stale (0 = never)
  config: 90      # settings, thresholds, routing, versions, deployments
  topology: 180   # architecture, which service does what, where things live
  relational: 180 # ownership, roles, who-to-ask
  never: 0        # recorded decisions/history — true forever as history
defaults:         # decay class by top-level area when a subject sets none
  people: relational
  decision: never
subjects:
"""


def index_edges(con: sqlite3.Connection, fm: dict) -> None:
    src = fm.get("id")
    if not src:
        return
    con.execute("DELETE FROM edges WHERE src = ?", (src,))
    for kind in ("related", "supersedes", "contradicts", "derived_from",
                 "evidence_for", "refuted_by", "rivals", "models"):
        for t in fm.get(kind) or []:
            if isinstance(t, str):
                con.execute("INSERT OR IGNORE INTO edges VALUES (?,?,?)", (src, kind, t))
    sb = fm.get("superseded_by")
    if isinstance(sb, str):
        con.execute("INSERT OR IGNORE INTO edges VALUES (?,?,?)", (src, "superseded_by", sb))


# ---------------------------------------------------------------- embeddings
#
# Local static embeddings (model2vec): tokenize -> table lookup -> mean-pool.
# No torch, no ONNX runtime, ~ms per text — cheap enough to ride the incremental
# index path. Vector search is one leg of RRF fusion; BM25 is the other; the
# LLM re-ranks in-session. Model is cached under .index/model/ after the first
# (network) download; everything degrades gracefully to lexical-only without it.
# Kill switch: KB_NO_EMBED=1.

EMBED_MODEL = os.environ.get("KB_EMBED_MODEL", "minishlab/potion-retrieval-32M")


def _encoder(root: Path):
    """Lazy-load the embedding model once per process; None if unavailable."""
    if hasattr(_encoder, "_m"):
        return _encoder._m
    m = None
    if not os.environ.get("KB_NO_EMBED"):
        try:
            from model2vec import StaticModel
            cache = root / ".index" / "model" / EMBED_MODEL.split("/")[-1]
            if cache.is_dir():
                m = StaticModel.from_pretrained(str(cache))
            else:
                m = StaticModel.from_pretrained(EMBED_MODEL)  # downloads once
                cache.mkdir(parents=True, exist_ok=True)
                m.save_pretrained(str(cache))
        except Exception as e:
            print(f"kb: embeddings unavailable ({type(e).__name__}) — lexical only",
                  file=sys.stderr)
            m = None
    _encoder._m = m
    return m


def _embed(root: Path, texts: list[str]):
    """L2-normalized float32 matrix, or None when no encoder is available."""
    m = _encoder(root)
    if m is None:
        return None
    import numpy as np
    v = np.asarray(m.encode(texts), dtype=np.float32)
    if v.ndim == 1:
        v = v.reshape(1, -1)
    norms = np.linalg.norm(v, axis=1, keepdims=True)
    norms[norms == 0] = 1.0
    return v / norms


def _chunks(body: str, size: int = 1200, overlap: int = 150) -> list[str]:
    """Greedy paragraph packing; short bodies ride the head vector alone."""
    if len(body) <= 1800:
        return []
    chunks: list[str] = []
    cur = ""
    for para in body.split("\n\n"):
        if cur and len(cur) + len(para) > size:
            chunks.append(cur)
            cur = cur[-overlap:] + "\n\n" + para
        else:
            cur = f"{cur}\n\n{para}" if cur else para
    if cur.strip():
        chunks.append(cur)
    return chunks


def cmd_index(args) -> int:
    root = kb_root()
    con = open_db(root)
    # embedding-model change invalidates every vector: wipe and force re-read
    row = con.execute("SELECT v FROM kv WHERE k = 'embed_model'").fetchone()
    if row and row[0] != EMBED_MODEL:
        con.execute("DELETE FROM vectors")
        con.execute("UPDATE meta SET mtime = 0")
    known = {p: m for p, m in con.execute("SELECT path, mtime FROM meta")}
    if args.rebuild:
        con.execute("DELETE FROM meta")
        con.execute("DELETE FROM docs")
        con.execute("DELETE FROM edges")
        con.execute("DELETE FROM vectors")
        known = {}
    seen, added, refreshed = set(), 0, 0
    claims_dirty = bool(args.rebuild)
    pending: list[tuple[str, str, list[str]]] = []  # (uri, head text, body chunks)
    for path in walk_md(root):
        uri = to_kb_uri(root, path)
        seen.add(uri)
        mtime = path.stat().st_mtime
        if uri in known and known[uri] == mtime:
            continue
        fm, body = parse_fm(path)
        if fm is None:
            continue  # invalid files are the validator's problem, not the index's
        doctype = ("route" if path.name == "_route.md"
                   else "recipe" if fm.get("type") == "recipe"
                   else "model" if fm.get("type") == "model"
                   else "problem" if fm.get("type") == "problem" else "entry")
        d = doc_fields(fm, body, doctype)
        # Transcript bodies are NOT indexed (measured 2026-09-16 on _eval.yaml:
        # body text and body chunk vectors both lowered MRR — they let a long
        # transcript outrank the entry whose summary actually answers). The
        # distilled fields are the retrieval surface; the body is HOT payload.
        d["body"] = ""
        con.execute("DELETE FROM docs WHERE path = ?", (uri,))
        con.execute(
            "INSERT INTO docs (id,title,topics,participants,summary,extra,body,path) "
            "VALUES (?,?,?,?,?,?,?,?)",
            (d["id"], d["title"], d["topics"], d["participants"],
             d["summary"], d["extra"], d["body"], uri))
        con.execute(
            "INSERT OR REPLACE INTO meta VALUES (?,?,?,?,?,?,?,?,?,?)",
            (uri, mtime, d["id"] or None, doctype, fm.get("status"),
             d["title"], fm.get("created"), fm.get("updated"),
             d["topics"], d["participants"]))
        index_edges(con, fm)
        if doctype != "route":
            head = " | ".join(x for x in (d["title"], d["topics"],
                                          d["summary"], d["extra"]) if x)
            pending.append((uri, head, []))
        if doctype == "entry":
            for cpath, chead in index_claims(con, fm, uri, mtime):
                pending.append((cpath, chead, []))
                seen.add(cpath)
            claims_dirty = True
        refreshed += 1 if uri in known else 0
        added += 0 if uri in known else 1
    for path in walk_txt(root):
        uri = to_kb_uri(root, path)
        seen.add(uri)
        mtime = path.stat().st_mtime
        if uri in known and known[uri] == mtime:
            continue
        try:
            text = path.read_text()
        except Exception:
            continue
        title = path.stem.replace("-", " ")
        con.execute("DELETE FROM docs WHERE path = ?", (uri,))
        # an attachment IS its text — it rides the weighted `extra` column
        con.execute(
            "INSERT INTO docs (id,title,topics,participants,summary,extra,body,path) "
            "VALUES (?,?,?,?,?,?,?,?)", ("", title, "", "", "", text, "", uri))
        con.execute(
            "INSERT OR REPLACE INTO meta VALUES (?,?,?,?,?,?,?,?,?,?)",
            (uri, mtime, None, "attachment", None, title, None, None, "", ""))
        pending.append((uri, title, _chunks(text)))
        refreshed += 1 if uri in known else 0
        added += 0 if uri in known else 1
    if pending:
        texts, keys = [], []
        for uri, head, chunks in pending:
            texts.append(head)
            keys.append((uri, "head"))
            for i, c in enumerate(chunks):
                texts.append(c)
                keys.append((uri, f"chunk:{i}"))
        vecs = _embed(root, texts)
        if vecs is not None:
            for uri, _, _ in pending:
                con.execute("DELETE FROM vectors WHERE path = ?", (uri,))
            for (uri, kind), v in zip(keys, vecs):
                con.execute("INSERT OR REPLACE INTO vectors VALUES (?,?,?,?)",
                            (uri, kind, v.shape[0], v.tobytes()))
            con.execute("INSERT OR REPLACE INTO kv VALUES ('embed_model', ?)",
                        (EMBED_MODEL,))
    kept_claims = {r[0] for r in con.execute(
        "SELECT c.path FROM claims c JOIN meta m ON m.id = c.episode WHERE m.path IN (" +
        ",".join("?" * len(seen)) + ")", list(seen))} if seen else set()
    gone = set(known) - seen - kept_claims
    for uri in gone:
        con.execute("DELETE FROM meta WHERE path = ?", (uri,))
        con.execute("DELETE FROM docs WHERE path = ?", (uri,))
        con.execute("DELETE FROM vectors WHERE path = ?", (uri,))
        con.execute("DELETE FROM claims WHERE path = ?", (uri,))
        claims_dirty = True
    if claims_dirty:
        derive_claims(con)
        minted = register_subjects(root, con)
        if minted and not args.quiet:
            print("kb index: new subjects registered in _subjects.yaml: " + ", ".join(minted))
    con.commit()
    n = con.execute("SELECT count(*) FROM meta").fetchone()[0]
    if not args.quiet:
        print(f"kb index: {n} docs ({added} added, {refreshed} refreshed, {len(gone)} removed)")
    return 0


def ensure_index(root: Path) -> sqlite3.Connection:
    """Open the db, refreshing it first so results are never stale."""

    class _A:
        rebuild = False
        quiet = True

    cmd_index(_A())
    return open_db(root)


# -------------------------------------------------------------------- search

def fts_query(raw: str) -> str:
    # Quoted spans become FTS phrase terms ('"recovery update"' matches adjacent
    # tokens in order); everything else stays a bag-of-words OR.
    terms: list[str] = []
    for phrase in re.findall(r'"([^"]+)"', raw):
        words = re.findall(r"[A-Za-z0-9_]+", phrase)
        if words:
            terms.append('"' + " ".join(words) + '"')
    rest = re.sub(r'"[^"]*"', " ", raw)
    terms += [f'"{t}"' for t in re.findall(r"[A-Za-z0-9_]+", rest)]
    if not terms:
        sys.exit("kb search: query has no searchable tokens")
    return " OR ".join(terms)


# Ranking constants — tuned 2026-09-16 on the _eval.yaml gold set (hybrid MRR
# 0.55 -> 0.66). Re-tune with KB_INDEX_DB=<scratch> + `kb eval`, never by feel.
# column weights: id, title, topics, participants, summary, extra, body, path
BM25_WEIGHTS = "4.0, 10.0, 6.0, 3.0, 7.0, 3.0, 0.0, 0.0"
RRF_K = 20       # small k: a doc both legs agree on beats a doc one leg loves
CANDIDATES = 50  # per-leg depth feeding the fusion
# Post-fusion prior by doctype: the theory layer restates episode vocabulary, so
# without this a model/problem outranks the very episode that grounds it.
DOCTYPE_PRIOR = {"model": 0.7, "problem": 0.3}


def bm25_leg(con, raw_query: str, limit: int = CANDIDATES,
             claims: bool = False) -> list[tuple[str, float]]:
    """[(path, bm25_score_negated_better_bigger)], best first."""
    where = "" if claims else "AND docs.path NOT LIKE 'claim:%' "
    sql = (f"SELECT docs.path, bm25(docs, {BM25_WEIGHTS}) AS score "
           f"FROM docs WHERE docs MATCH ? {where}ORDER BY score LIMIT ?")
    return [(r[0], -r[1]) for r in con.execute(sql, (fts_query(raw_query), limit))]


def vector_leg(root: Path, con, raw_query: str, limit: int = CANDIDATES,
               claims: bool = False) -> list[tuple[str, float]]:
    """[(path, cosine)], best first; doc score = max over its vectors, small
    head boost so distilled matches beat transcript-noise matches."""
    q = _embed(root, [raw_query])
    if q is None:
        return []
    rows = con.execute("SELECT path, kind, vec FROM vectors" +
                       ("" if claims else " WHERE path NOT LIKE 'claim:%'")).fetchall()
    if not rows:
        return []
    import numpy as np
    mat = np.frombuffer(b"".join(r[2] for r in rows),
                        dtype=np.float32).reshape(len(rows), -1)
    scores = mat @ q[0]
    best: dict[str, float] = {}
    for (path, kind, _), s in zip(rows, scores):
        s = float(s) * (1.05 if kind == "head" else 1.0)
        if s > best.get(path, -2.0):
            best[path] = s
    return sorted(best.items(), key=lambda x: -x[1])[:limit]


def fuse_rrf(*legs: list[tuple[str, float]]) -> list[tuple[str, float]]:
    scores: dict[str, float] = {}
    for leg in legs:
        for rank, (path, _s) in enumerate(leg):
            scores[path] = scores.get(path, 0.0) + 1.0 / (RRF_K + rank + 1)
    return sorted(scores.items(), key=lambda x: -x[1])


def ranked_paths(root: Path, con, raw_query: str, mode: str,
                 claims: bool = False) -> tuple[str, list, dict, dict]:
    """Resolve mode, run the legs, fuse. Returns (effective_mode,
    [(path, score)], bm_ranks, vec_ranks)."""
    has_vecs = con.execute("SELECT 1 FROM vectors LIMIT 1").fetchone()
    if mode == "hybrid" and not has_vecs:
        mode = "lexical"
    if mode == "vector" and not has_vecs:
        sys.exit("kb search: no vectors in the index — run `kb index` with network "
                 "access once (or unset KB_NO_EMBED)")
    # Claims are a different retrieval surface: `kb facts` resolves them by key and
    # auto-recall scores them on its own path. Letting them into the ranking legs
    # costs episode recall (measured: hybrid MRR 0.687 -> 0.644) because ~350 short
    # docs displace entries from the candidate window. Opt in with --claims.
    bm = bm25_leg(con, raw_query, claims=claims) if mode in ("lexical", "hybrid") else []
    vec = vector_leg(root, con, raw_query, claims=claims) if mode in ("vector", "hybrid") else []
    if mode == "hybrid" and not vec:
        mode = "lexical"  # encoder unavailable right now — degrade silently
    bm_ranks = {p: i + 1 for i, (p, _) in enumerate(bm)}
    vec_ranks = {p: i + 1 for i, (p, _) in enumerate(vec)}
    if mode == "lexical":
        fused = bm
    elif mode == "vector":
        fused = vec
    else:
        fused = fuse_rrf(bm, vec)
    dt = {r[0]: r[1] for r in con.execute("SELECT path, doctype FROM meta")}
    fused = sorted(((p, s * DOCTYPE_PRIOR.get(dt.get(p, ""), 1.0)) for p, s in fused),
                   key=lambda x: -x[1])
    return mode, fused, bm_ranks, vec_ranks


def leaf_path(root: Path, con: sqlite3.Connection, uri: str) -> str:
    """Filesystem path for a kb:/ URI, or the asserting episode's path for a claim."""
    if uri.startswith("claim:"):
        eid = uri.split(":")[1]
        row = con.execute("SELECT path FROM meta WHERE id = ?", (eid,)).fetchone()
        return str(from_kb_uri(root, row[0])) + f"  (claim {uri.rsplit(':', 1)[1]})" if row else uri
    return str(from_kb_uri(root, uri))


def cmd_search(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    mode, cand, bm_ranks, vec_ranks = ranked_paths(
        root, con, " ".join(args.query), args.mode, claims=args.claims)
    if not cand:
        print("no hits")
        return 1
    # filters apply post-fusion — cheap at this scale, and identical across modes
    qmarks = ",".join("?" * len(cand))
    sql = (f"SELECT m.path, m.id, m.doctype, m.status, m.title, m.created, m.topics, "
           f"(SELECT summary FROM docs WHERE docs.path = m.path) "
           f"FROM meta m WHERE m.path IN ({qmarks})")
    params: list[object] = [p for p, _ in cand]
    if args.type != "all":
        sql += " AND m.doctype = ?"
        params.append(args.type)
    elif not args.routes:
        sql += " AND m.doctype != 'route'"
    if args.type != "claim" and not args.claims:
        sql += " AND m.doctype != 'claim'"
    if not args.all_status:
        # active/draft are the live leaf+recipe statuses; hypothesis/corroborated the
        # live model ones; open/ready the live problem ones
        sql += (" AND (m.status IN ('active','draft','hypothesis','corroborated',"
                "'open','ready') OR m.status IS NULL)")
    for t in args.topic or []:
        sql += " AND (',' || replace(m.topics, ' ', '') || ',') LIKE ?"
        params.append(f"%,{t},%")
    for p in args.person or []:
        sql += " AND (',' || replace(m.participants, ' ', '') || ',') LIKE ?"
        params.append(f"%,{p},%")
    meta = {r[0]: r[1:] for r in con.execute(sql, params)}
    hits = [(p, s) for p, s in cand if p in meta][: args.n]
    if args.json:
        out = []
        for uri, score in hits:
            rid, doctype, status, title, created, topics, summary = meta[uri]
            out.append({"id": rid, "path": leaf_path(root, con, uri), "kb_path": uri,
                        "type": doctype, "status": status, "title": title,
                        "created": created, "topics": topics,
                        "score": round(score, 4), "mode": mode,
                        "bm25_rank": bm_ranks.get(uri), "vec_rank": vec_ranks.get(uri),
                        "summary": first_line(summary)})
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0
    if not hits:
        print("no hits")
        return 1
    for uri, score in hits:
        rid, doctype, status, title, created, topics, summary = meta[uri]
        label = doctype + ("" if status in (None, "active") else f", {status}")
        shown = f"{score:6.2f}" if mode != "hybrid" else f"{score:6.4f}"
        print(f"[{shown}] {rid or uri}  ({label})")
        print(f"         file: {leaf_path(root, con, uri)}")
        print(f"         title: {title}" + (f"  ({created[:10]})" if created else ""))
        if topics:
            print(f"         topics: {topics}")
        if summary:
            print(f"         summary: {first_line(summary)}")
    return 0


# ---------------------------------------------------------------- transcript
#
# The transcript is the HOT-tier payload of an episode. Rendering it is
# clerical work: user turns verbatim, assistant text verbatim, tool calls as
# one-line stubs, tool results truncated, thinking and sidechains dropped.
# Before this existed the LLM re-typed ~10 KB of transcript per filing.

TOOL_RESULT_MAX = 300


def _strip_meta_markup(text: str) -> str:
    text = re.sub(r"<system-reminder>.*?</system-reminder>", "", text, flags=re.S)
    text = re.sub(r"<local-command-stdout>.*?</local-command-stdout>", "", text, flags=re.S)
    text = re.sub(r"<local-command-caveat>.*?</local-command-caveat>", "", text, flags=re.S)
    m = re.search(r"<command-name>(.*?)</command-name>", text, flags=re.S)
    if m:
        args = re.search(r"<command-args>(.*?)</command-args>", text, flags=re.S)
        cmd = m.group(1).strip()
        cmd = cmd if cmd.startswith("/") else "/" + cmd
        text = f"{cmd} {args.group(1).strip() if args else ''}".strip()
    return text.strip()


def _tool_stub(block: dict) -> str:
    name = block.get("name") or "tool"
    inp = block.get("input") or {}
    for k in ("description", "command", "file_path", "pattern", "query", "url", "prompt"):
        v = inp.get(k)
        if isinstance(v, str) and v.strip():
            v = " ".join(v.split())
            return f"[tool: {name} — {v[:140]}{'…' if len(v) > 140 else ''}]"
    return f"[tool: {name}]"


def render_transcript(path: Path, owner: str = "User") -> tuple[dict, str]:
    """(meta, markdown). Faithful to turn order; payloads condensed, never invented."""
    meta = {"session_id": None, "cwd": None, "started": None, "ended": None, "user_turns": 0}
    out: list[str] = []
    for raw in path.read_text().splitlines():
        try:
            l = json.loads(raw)
        except json.JSONDecodeError:
            continue
        t = l.get("type")
        if t not in ("user", "assistant") or l.get("isSidechain"):
            continue
        meta["session_id"] = meta["session_id"] or l.get("sessionId")
        meta["cwd"] = meta["cwd"] or l.get("cwd")
        if l.get("timestamp"):
            meta["started"] = meta["started"] or l["timestamp"]
            meta["ended"] = l["timestamp"]
        content = (l.get("message") or {}).get("content")
        if t == "user":
            if isinstance(content, str):
                text = _strip_meta_markup(content)
                if text and not l.get("isMeta"):
                    meta["user_turns"] += 1
                    out.append(f"**{owner}:** {text}\n")
                continue
            texts: list[str] = []
            for b in content or []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text":
                    texts.append(b.get("text") or "")
                elif b.get("type") == "tool_result":
                    c = b.get("content")
                    if isinstance(c, list):
                        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                    c = " ".join(str(c or "").split())
                    if c:
                        out.append(f"> [result] {c[:TOOL_RESULT_MAX]}"
                                   f"{'…' if len(c) > TOOL_RESULT_MAX else ''}\n")
            text = _strip_meta_markup("\n".join(texts))
            if text and not l.get("isMeta"):
                meta["user_turns"] += 1
                out.append(f"**{owner}:** {text}\n")
        else:
            parts: list[str] = []
            for b in content or []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and (b.get("text") or "").strip():
                    parts.append(b["text"].strip())
                elif b.get("type") == "tool_use":
                    parts.append(_tool_stub(b))
            if parts:
                out.append("**Claude:** " + "\n".join(parts) + "\n")
    head = ("# Transcript (condensed by `kb transcript`: faithful to turn order, tool "
            "payloads truncated, thinking omitted)\n\n"
            f"session `{meta['session_id']}` · cwd `{meta['cwd']}` · "
            f"{(meta['started'] or '')[:16]} → {(meta['ended'] or '')[:16]} · "
            f"{meta['user_turns']} user turns\n\n")
    return meta, head + "\n".join(out)


def cmd_transcript(args) -> int:
    p = Path(args.path).expanduser()
    if not p.is_file():
        sys.exit(f"kb transcript: no such file {p}")
    meta, text = render_transcript(p, owner=args.owner)
    print(text, end="")
    print(f"\n<!-- kb transcript: {meta['user_turns']} user turns, {len(text)} chars -->")
    return 0


# ---------------------------------------------------------------------- file
#
# The deterministic leaf writer. Judgment (title, summary, topics, decisions,
# placement) arrives as one small JSON payload from the LLM; everything else —
# id, timestamps, key order, YAML quoting, transcript, folder bootstrap,
# validation, route bookkeeping, index refresh, same-topic living-layer lookup
# — happens here. A leaf that fails the schema is never written.

LEAF_KEYS = ("id", "title", "created", "updated", "participants", "topics", "related",
             "sources", "status", "supersedes", "superseded_by", "contradicts",
             "recipe_candidate", "decisions", "open_questions", "claims", "summary")


def slugify(text: str, limit: int = 64) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    slug = re.sub(r"^\d{4}-\d{2}-\d{2}-", "", slug)  # never double a date prefix
    if len(slug) > limit:  # cut at a word boundary, never mid-word
        slug = slug[:limit].rsplit("-", 1)[0] if "-" in slug[:limit] else slug[:limit]
    return slug.strip("-") or "entry"


def yblock(v: str, indent: int = 2) -> str:
    """Literal block scalar for multi-line prose (summary)."""
    pad = " " * indent
    body = "\n".join(pad + line if line.strip() else "" for line in v.strip().splitlines())
    return "|\n" + body


def ylist(items: list, indent: int = 2) -> str:
    if not items:
        return "[]"
    pad = " " * indent
    return "\n" + "\n".join(f"{pad}- {ydump(str(i))}" for i in items)


def emit_leaf(fm: dict, body: str) -> str:
    lines = ["---"]
    for k in LEAF_KEYS:
        v = fm.get(k)
        if k == "summary":
            lines.append(f"summary: {yblock(v)}")
        elif k == "topics":
            lines.append(f"topics: {yflow(v or [])}")  # one line: audit-topics rewrites it
        elif k in ("participants",):
            lines.append(f"{k}: {yflow(v or [])}")
        elif k in ("related", "sources", "supersedes", "contradicts", "decisions", "open_questions"):
            lines.append(f"{k}:{ylist(v or [])}" if v else f"{k}: []")
        elif k == "superseded_by":
            lines.append("superseded_by: null" if v is None else f"superseded_by: {ydump(v)}")
        elif k == "claims":
            if not v:
                lines.append("claims: []")
            else:
                lines.append("claims:")
                for c in v:
                    lines.append(f"  - subject: {c['subject']}")
                    lines.append(f"    value: {ydump(c['value'])}")
                    for ck in ("scope", "since", "kind", "source"):
                        if c.get(ck) not in (None, "", {}):
                            lines.append(f"    {ck}: {ydump(c[ck])}")
        elif k == "recipe_candidate":
            lines.append(f"recipe_candidate: {'true' if v else 'false'}")
        else:
            lines.append(f"{k}: {ydump(v)}")
    lines.append("---")
    return "\n".join(lines) + "\n\n" + body.rstrip() + "\n"


def session_state_path(root: Path, cwd: str) -> Path:
    slug = re.sub(r"[^A-Za-z0-9]+", "-", cwd).strip("-")
    return root / ".index" / "sessions" / f"{slug}.json"


def resolve_session(root: Path, ref: str, cwd: str | None) -> Path:
    if ref != "auto":
        p = Path(ref).expanduser()
        if not p.is_file():
            sys.exit(f"kb file: transcript not found: {p}")
        return p
    cwd = cwd or os.getcwd()
    st = session_state_path(root, cwd)
    if not st.is_file():
        sys.exit("kb file: no recorded session for this cwd (the UserPromptSubmit hook "
                 "records it) — pass --session <path-to-jsonl> explicitly")
    data = json.loads(st.read_text())
    p = Path(data.get("transcript_path", ""))
    if not p.is_file():
        sys.exit(f"kb file: recorded transcript missing on disk: {p}")
    return p


def living_candidates(con: sqlite3.Connection, topics: list[str]) -> list[tuple]:
    """Models/recipes sharing >=1 topic with a fresh entry — the bounded sweep
    the filing procedure's living-layer check reads instead of the whole corpus."""
    if not topics:
        return []
    sql = ("SELECT id, doctype, status, title, topics FROM meta WHERE doctype IN "
           "('model','recipe') AND status NOT IN ('superseded','refuted') AND (" +
           " OR ".join(["(',' || replace(topics, ' ', '') || ',') LIKE ?"] * len(topics)) +
           ")")
    want = {t.lower() for t in topics}
    rows = []
    for r in con.execute(sql, [f"%,{t},%" for t in topics]):
        have = {t.strip().lower() for t in (r[4] or "").split(",")}
        rows.append((len(want & have), r))
    rows.sort(key=lambda x: (-x[0], x[1][1], x[1][0]))
    # a single shared broad tag (e.g. the product name) is not a reason to read a
    # model; prefer >=2 shared topics, fall back to the top few single-overlap ones
    strong = [r for n, r in rows if n >= 2]
    return strong or [r for _, r in rows[:4]]


def validate_tree(root: Path) -> list[str]:
    v = engine_dir() / "scripts" / "validate.py"
    r = subprocess.run(["uv", "run", "--quiet", str(v), "--quiet"],
                       capture_output=True, text=True,
                       env={**os.environ, "KB_DATA_DIR": str(root)})
    return [l for l in (r.stderr or "").splitlines() if l.startswith("kb:/")]


def dequeue_capture(root: Path, transcript: Path) -> None:
    q = root / ".librarian" / "capture-queue.tsv"
    if q.is_file():
        keep = [l for l in q.read_text().splitlines() if str(transcript) not in l]
        q.write_text("\n".join(keep) + ("\n" if keep else ""))


def cmd_file(args) -> int:
    root = kb_root()
    raw = sys.stdin.read() if args.meta == "-" else Path(args.meta).read_text()
    try:
        meta = json.loads(raw)
    except json.JSONDecodeError as e:
        sys.exit(f"kb file: --meta is not valid JSON: {e}")
    missing = [k for k in ("title", "summary", "folder") if not meta.get(k)]
    if missing:
        sys.exit(f"kb file: payload missing {missing}")
    if len(str(meta["summary"]).strip()) < 20:
        sys.exit("kb file: summary too short — it is the WARM-tier payload")
    if not args.jot and not args.session:
        sys.exit("kb file: pass --session <jsonl>|auto (episode) or --jot (no transcript)")

    folder_uri = str(meta["folder"]).rstrip("/")
    if not folder_uri.startswith("kb:/"):
        sys.exit(f"kb file: folder must be a kb:/ URI, got {folder_uri!r}")
    folder = from_kb_uri(root, folder_uri)
    created_folder = False
    if not folder.is_dir():
        purpose = str(meta.get("folder_purpose") or "").strip()
        if len(purpose) < 15:
            sys.exit(f"kb file: {folder_uri} does not exist — pass folder_purpose "
                     f"(one good sentence; it is hand-curated forever) to create it")
        if not (folder.parent / "_route.md").is_file():
            sys.exit(f"kb file: parent {to_kb_uri(root, folder.parent)} has no _route.md — "
                     f"create one level at a time")
        created_folder = True

    owner = (meta.get("participants") or ["user"])[0]
    transcript_path = None
    if args.jot:
        body = str(meta.get("body") or meta["summary"]).strip()
        tmeta = {}
    else:
        transcript_path = resolve_session(root, args.session, args.cwd)
        tmeta, body = render_transcript(transcript_path, owner=str(owner).capitalize())
        if tmeta["user_turns"] == 0:
            sys.exit(f"kb file: {transcript_path} rendered to zero user turns — wrong file?")

    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    slug = slugify(str(meta.get("slug") or meta["title"]))
    con = open_db(root)
    base_id, leaf_id, n = f"{today}-{slug}", f"{today}-{slug}", 2
    while (folder / f"{leaf_id}.md").exists() or \
            con.execute("SELECT 1 FROM meta WHERE id = ?", (leaf_id,)).fetchone():
        leaf_id = f"{base_id}-{n}"
        n += 1
    now = now_iso()
    related = [str(r) for r in (meta.get("related") or [])]
    route_uri = f"{folder_uri}/_route.md"
    if route_uri not in related:
        related.insert(0, route_uri)
    claims_in = []
    for c in meta.get("claims") or []:
        if not isinstance(c, dict):
            continue
        subj = str(c.get("subject") or "").strip().lower()
        if not SUBJECT_RE.match(subj):
            sys.exit(f"kb file: claim subject {subj!r} is not a dotted key like area.thing.attribute")
        if not str(c.get("value") or "").strip():
            sys.exit(f"kb file: claim on {subj} has no value")
        if c.get("kind") and c["kind"] not in CLAIM_KINDS:
            sys.exit(f"kb file: claim kind must be one of {CLAIM_KINDS}")
        item = {"subject": subj, "value": str(c["value"]).strip()}
        if isinstance(c.get("scope"), dict) and c["scope"]:
            item["scope"] = c["scope"]
        if c.get("since"):
            item["since"] = str(c["since"])[:10]
        if c.get("kind"):
            item["kind"] = c["kind"]
        if c.get("source"):
            item["source"] = str(c["source"])
        claims_in.append(item)
    fm = {
        "id": leaf_id, "title": str(meta["title"]).strip(), "created": now, "updated": now,
        "participants": [str(x) for x in (meta.get("participants") or [owner])],
        "topics": [str(t) for t in (meta.get("topics") or [])],
        "related": related,
        "sources": [str(u) for u in (meta.get("sources") or [])],
        "status": "active", "supersedes": [], "superseded_by": None, "contradicts": [],
        "recipe_candidate": bool(meta.get("recipe_candidate", False)),
        "decisions": [str(d) for d in (meta.get("decisions") or [])],
        "open_questions": [str(q) for q in (meta.get("open_questions") or [])],
        "claims": claims_in,
        "summary": str(meta["summary"]).strip(),
    }
    text = emit_leaf(fm, body)
    leaf = folder / f"{leaf_id}.md"

    if args.dry_run:
        print(f"would write {to_kb_uri(root, leaf)}" +
              (f" (creating {folder_uri})" if created_folder else ""))
        print(text[: text.index("\n---\n", 4) + 5])
        print(f"[body: {len(body)} chars" +
              (f", {tmeta['user_turns']} user turns from {transcript_path}" if tmeta else "") + "]")
        return 0

    if created_folder:
        folder.mkdir(parents=True)
        title = folder.name.replace("-", " ").title()
        (folder / "_route.md").write_text(
            f"---\ntype: route\nfolder: {folder_uri}\ntitle: {ydump(title)}\n"
            f"purpose: {ydump(purpose)}\nlast_indexed: {now}\ntopics: []\nsubroutes: []\n"
            f"entries: []\nrelated: []\n---\n\n# {title}\n")
    leaf.write_text(text)
    cmd_reindex_routes(argparse.Namespace(dry_run=False, quiet=True))
    errors = [e for e in validate_tree(root)
              if leaf.name in e or (created_folder and folder_uri in e)]
    if errors:
        leaf.unlink()
        if created_folder:
            (folder / "_route.md").unlink()
            folder.rmdir()
        cmd_reindex_routes(argparse.Namespace(dry_run=False, quiet=True))
        print("kb file: REFUSED — the leaf would violate the schema:", file=sys.stderr)
        for e in errors:
            print("  " + e, file=sys.stderr)
        return 1
    cmd_sync(argparse.Namespace(quiet=True))
    if transcript_path:
        dequeue_capture(root, transcript_path)

    con = open_db(root)
    print(f"FILED {leaf}")
    print(f"  id: {leaf_id}" + (f"   (new folder {folder_uri})" if created_folder else ""))
    print(f"  topics: {', '.join(fm['topics']) or '-'}")
    if tmeta:
        print(f"  transcript: {tmeta['user_turns']} user turns, {len(body)} chars, "
              f"session {tmeta['session_id']}")
    if claims_in:
        vocab = load_subjects(root)
        print(f"  claims: {len(claims_in)}")
        for c in claims_in:
            key = c["subject"] + (f" [{scope_key(c.get('scope'))}]" if c.get("scope") else "")
            prior = con.execute(
                "SELECT value, since, episode, valid_to FROM claims WHERE subject = ? AND scope = ? "
                "AND episode != ? ORDER BY since DESC LIMIT 1",
                (c["subject"], scope_key(c.get("scope")), leaf_id)).fetchone()
            note = ""
            if prior:
                same = norm_value(prior[0]) == norm_value(c["value"])
                note = (f"  ← confirms {prior[2]}" if same else
                        f"  ← SUPERSEDES {prior[2]} ({prior[1]}: {first_line(prior[0], 70)!r})")
            newsubj = "  (new subject — check `kb subjects --match` for an existing key first)" \
                if c["subject"] not in vocab["subjects"] else ""
            print(f"    {key} = {first_line(c['value'], 80)}{note}{newsubj}")
    cands = living_candidates(con, fm["topics"])
    if cands:
        print("  same-topic living layer — check each against this entry "
              "(refutes/corroborates a model? outdates a recipe step?):")
        for cid, doctype, status, title, _ in cands:
            print(f"    {cid}  ({doctype}, {status}) — {first_line(title, 90)}")
    else:
        print("  same-topic living layer: none — nothing to check")
    return 0


# --------------------------------------------------------------------- facts

def current_claims(con: sqlite3.Connection, prefix: str | None = None,
                   as_of: str | None = None, scope: dict[str, str] | None = None,
                   include_superseded: bool = False) -> list[sqlite3.Row]:
    con.row_factory = sqlite3.Row
    sql = "SELECT * FROM claims WHERE 1=1"
    params: list[object] = []
    if prefix:
        sql += " AND (subject = ? OR subject LIKE ?)"
        params += [prefix, prefix + ".%"]
    if as_of:
        sql += " AND since <= ? AND (valid_to IS NULL OR valid_to > ?)"
        params += [as_of, as_of]
    elif not include_superseded:
        sql += " AND valid_to IS NULL"
    sql += " ORDER BY subject, scope, since, asserted"
    rows = con.execute(sql, params).fetchall()
    con.row_factory = None
    if scope is not None:
        rows = [r for r in rows if scope_matches(r["scope"], scope)]
    return rows


def resolve_scope(rows: list, scope: dict[str, str]) -> sqlite3.Row | None:
    """Most specific applicable claim wins; the unscoped one is the default."""
    applicable = [r for r in rows if scope_matches(r["scope"], scope)]
    if not applicable:
        return None
    return max(applicable, key=lambda r: (len(parse_scope(r["scope"])), r["since"]))


def cmd_facts(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    want = dict(kv.split("=", 1) for kv in (args.scope or []) if "=" in kv)
    rows = current_claims(con, args.subject, as_of=args.as_of,
                          include_superseded=args.history)
    if not rows:
        print("no claims" + (f" under {args.subject}" if args.subject else "") +
              (f" as of {args.as_of}" if args.as_of else ""))
        return 1
    vocab = load_subjects(root)
    by_subject: dict[str, list] = {}
    for r in rows:
        by_subject.setdefault(r["subject"], []).append(r)
    if args.json:
        out = []
        for subj, rs in by_subject.items():
            pick = resolve_scope([r for r in rs if r["valid_to"] is None or args.as_of], want) if want else None
            out.append({"subject": subj, "resolved": dict(pick) if pick else None,
                        "claims": [dict(r) for r in rs]})
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0
    now = datetime.now(timezone.utc).date()
    for subj, rs in by_subject.items():
        print(subj)
        live = [r for r in rs if r["valid_to"] is None or args.as_of]
        if want:
            pick = resolve_scope(live, want)
            if pick:
                print(f"  → for {';'.join(f'{k}={v}' for k, v in want.items())}: {pick['value']}"
                      f"  (since {pick['since']}, {pick['kind']}, {pick['episode']})")
        for r in rs:
            tag = "  " if (r["valid_to"] is None or args.as_of) else "  ✗"
            scope = f"[{r['scope']}] " if r["scope"] else ""
            line = f"{tag} {scope}{r['value']}"
            meta = [f"since {r['since']}", r["kind"]]
            if r["confirmed"]:
                meta.append(f"confirmed {r['confirmed']}")
            if r["valid_to"]:
                meta.append(f"until {r['valid_to']} → {r['superseded_by'].split(':')[1]}")
            else:
                half = subject_decay_days(vocab, subj)
                ref = r["confirmed"] or r["since"]
                if half:
                    try:
                        age = (now - datetime.strptime(ref, "%Y-%m-%d").date()).days
                        if age > half:
                            meta.append(f"STALE? {age}d unconfirmed (decay {half}d)")
                    except ValueError:
                        pass
            print(f"{line}\n       {' · '.join(meta)} · {r['episode']}" +
                  (f"\n       {r['source']}" if r["source"] else ""))
    return 0


def rename_subject(root: Path, old: str, new: str) -> int:
    """Vocabulary curation: rewrite `subject: old` -> `subject: new` in every
    episode's claims, merge the _subjects.yaml entries (aliases union, old key
    kept as an alias), then reindex. Returns the number of claims moved."""
    if not SUBJECT_RE.match(new):
        sys.exit(f"kb subjects --rename: {new!r} is not a valid dotted subject")
    moved = 0
    pat = re.compile(rf"^(\s*-?\s*subject:\s*){re.escape(old)}\s*$", re.M)
    for p in walk_md(root):
        fm, _ = parse_fm(p)
        if not fm or not fm.get("claims"):
            continue
        text = p.read_text()
        new_text, n = pat.subn(rf"\g<1>{new}", text)
        if n:
            p.write_text(new_text)
            moved += n
    vp = root / "_subjects.yaml"
    if vp.is_file():
        text = vp.read_text()
        data = yaml.load(text, Loader=StrLoader) or {}
        subs = data.get("subjects") or {}
        o = subs.pop(old, None) or {}
        t = subs.get(new) or {}
        aliases = list(dict.fromkeys([*(t.get("aliases") or []), *(o.get("aliases") or []),
                                      old.replace(".", " ").replace("-", " ")]))
        subs[new] = {**o, **t, "aliases": aliases}
        # Rewrite ONLY the `subjects:` mapping; everything above it (the header
        # comment, decay classes, defaults) is hand-curated and stays byte-identical.
        m = re.search(r"^subjects:\s*$", text, re.M)
        if not m:
            sys.exit("kb subjects --rename: _subjects.yaml has no `subjects:` key")
        body = yaml.safe_dump({"subjects": dict(sorted(subs.items()))}, sort_keys=False,
                              allow_unicode=True, width=100)
        vp.write_text(text[: m.start()] + body)
    return moved


def cmd_subjects(args) -> int:
    root = kb_root()
    if args.rename:
        old, new = args.rename
        moved = rename_subject(root, old, new)
        cmd_index(argparse.Namespace(rebuild=False, quiet=True))
        print(f"kb subjects: {old} -> {new}: {moved} claim(s) moved; old key kept as an alias")
        return 0
    con = ensure_index(root)
    vocab = load_subjects(root)
    counts = {r[0]: (r[1], r[2]) for r in con.execute(
        "SELECT subject, count(*), sum(valid_to IS NULL) FROM claims GROUP BY subject")}
    subjects = sorted(set(vocab["subjects"]) | set(counts))
    if args.dups:
        # Curation aid. Two subjects are merge candidates only when they name the
        # same ATTRIBUTE of the same THING — same thing under different areas, or
        # thing names that are suffix variants of each other (vmf vs vmf-library).
        # Sharing a word is not enough: `.location` on two different things is
        # correct design, and a list of those is noise, not a work queue.
        import itertools

        def split3(x: str) -> tuple[str, str, str]:
            p = x.split(".")
            return p[0], ".".join(p[1:-1]), p[-1]

        pairs = []
        for a, b in itertools.combinations(subjects, 2):
            aa, at, an = split3(a)
            ba, bt, bn = split3(b)
            if an != bn or not at or not bt:
                continue
            if at == bt and aa != ba:
                pairs.append((a, b, "same thing + attribute, different area"))
            elif aa == ba and (at.startswith(bt + "-") or bt.startswith(at + "-")):
                pairs.append((a, b, "thing name is a suffix variant"))
        if not pairs:
            print("no merge candidates — every subject names a distinct thing+attribute")
            return 0
        for a, b, why in pairs:
            print(f"{why}:")
            for x in (a, b):
                row = con.execute("SELECT value FROM claims WHERE subject = ? "
                                  "ORDER BY since DESC LIMIT 1", (x,)).fetchone()
                print(f"    {x}  ({counts.get(x, (0, 0))[1]} current)")
                if row:
                    print(f"        {first_line(row[0], 100)}")
        print(f"\n{len(pairs)} candidate pair(s) — merge with "
              f"`kb subjects --rename <old> <new>` when they are the same fact")
        return 0
    if args.match:
        words = {w for w in re.findall(r"[a-z0-9]+", args.match.lower()) if len(w) >= 3}
        def hit(subj: str) -> bool:
            entry = vocab["subjects"].get(subj) or {}
            hay = subj.replace(".", " ").replace("-", " ") + " " + " ".join(
                str(a) for a in (entry.get("aliases") or []) if isinstance(entry, dict))
            return bool(words & set(re.findall(r"[a-z0-9]+", hay.lower())))
        subjects = [x for x in subjects if hit(x)]
    if not subjects:
        print("no subjects" + (f" matching {args.match!r}" if args.match else ""))
        return 1
    if args.json:
        print(json.dumps([{"subject": x, "claims": counts.get(x, (0, 0))[0],
                           "current": counts.get(x, (0, 0))[1],
                           **(vocab["subjects"].get(x) or {})} for x in subjects],
                         indent=2, ensure_ascii=False))
        return 0
    for x in subjects:
        n, cur = counts.get(x, (0, 0))
        entry = vocab["subjects"].get(x) or {}
        aliases = ", ".join(str(a) for a in (entry.get("aliases") or [])) if isinstance(entry, dict) else ""
        decay = subject_decay_days(vocab, x)
        print(f"{x}  ({cur} current / {n} total; decay {decay or 'never'})" +
              (f"\n    aliases: {aliases}" if aliases else ""))
    return 0


# --------------------------------------------------------------------- check
#
# "Things are not as they appear": given any text — a bot's answer, a tool
# result, a draft reply — find the subjects it touches and serve the KB's
# current claims on them, so the LLM can spot where the text and the KB
# disagree. Matching is deterministic (aliases, key words, BM25 over claim
# docs); judging is the LLM's job. Silence when nothing matches.

CHECK_MAX_SUBJECTS = 8


def subject_matchers(vocab: dict) -> dict[str, tuple[list[str], set[str]]]:
    """subject -> (alias phrases, key words after the area segment)."""
    out = {}
    for subj, entry in (vocab.get("subjects") or {}).items():
        aliases = [str(a).lower() for a in ((entry or {}).get("aliases") or [])] \
            if isinstance(entry, dict) else []
        words = {w for seg in subj.split(".")[1:] for w in seg.split("-") if len(w) >= 3}
        out[subj] = (aliases, words)
    return out


def check_candidates(root: Path, con: sqlite3.Connection, text: str) -> list[tuple[str, str]]:
    """[(subject, why)] ranked; alias/keyword hits first, then BM25 over claim docs."""
    low = " " + re.sub(r"\s+", " ", text.lower()) + " "
    words = set(re.findall(r"[a-z0-9]+", low))
    vocab = load_subjects(root)
    used = {r[0] for r in con.execute("SELECT DISTINCT subject FROM claims WHERE valid_to IS NULL")}
    scored: dict[str, tuple[int, str]] = {}
    for subj, (aliases, keys) in subject_matchers(vocab).items():
        if subj not in used:
            continue
        hit_alias = next((a for a in aliases if a and f" {a} " in low), None)
        overlap = keys & words
        if hit_alias:
            scored[subj] = (100 + len(overlap), f"mentions '{hit_alias}'")
        elif len(overlap) >= 2 or (len(keys) == 1 and overlap):
            scored[subj] = (10 * len(overlap), "words " + ", ".join(sorted(overlap)))
    toks = [t for t in re.findall(r"[A-Za-z0-9_-]{3,}", text.lower())
            if t not in RECALL_STOP][:32]
    if len(toks) >= 2:
        sql = (f"SELECT c.subject, bm25(docs, {BM25_WEIGHTS}) AS score FROM docs "
               f"JOIN claims c ON c.path = docs.path WHERE docs MATCH ? AND c.valid_to IS NULL "
               f"ORDER BY score LIMIT 12")
        for subj, score in con.execute(sql, (fts_query(" ".join(toks)),)):
            if -score >= RECALL_BM25_MIN and subj not in scored:
                scored[subj] = (int(-score), f"lexical match bm25={-score:.1f}")
    ranked = sorted(scored.items(), key=lambda x: -x[1][0])[:CHECK_MAX_SUBJECTS]
    return [(subj, why) for subj, (_, why) in ranked]


def cmd_check(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    text = sys.stdin.read()
    if len(text.strip()) < 20:
        return 1
    cands = check_candidates(root, con, text)
    if not cands:
        return 1
    if args.json:
        out = []
        for subj, why in cands:
            rows = current_claims(con, subj)
            out.append({"subject": subj, "why": why,
                        "claims": [dict(r) for r in rows if r["subject"] == subj]})
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0
    print("KB claims on subjects this text touches — compare each with what the text asserts; "
          "a disagreement is either the text being wrong (cite since + source) or the KB being "
          "stale (then file the correction):")
    for subj, why in cands:
        rows = [r for r in current_claims(con, subj) if r["subject"] == subj]
        print(f"\n{subj}   ({why})")
        for r in rows:
            scope = f"[{r['scope']}] " if r["scope"] else ""
            print(f"  {scope}{r['value']}")
            print(f"      since {r['since']} · {r['kind']}" +
                  (f" · confirmed {r['confirmed']}" if r["confirmed"] else "") +
                  f" · {r['episode']}" + (f" · {r['source']}" if r["source"] else ""))
    return 0


# ---------------------------------------------------------------------- eval

def cmd_eval(args) -> int:
    """Retrieval quality over the gold set in $KB_DATA_DIR/_eval.yaml.

    Cases: `- q: <natural query>` + `expect: [id, ...]` (any expected id counts).
    `expect: []` rows are the no-hit calibration set (used by auto-recall
    thresholding); they're skipped for ranking metrics.
    """
    root = kb_root()
    con = ensure_index(root)
    eval_path = root / "_eval.yaml"
    if not eval_path.exists():
        sys.exit(f"kb eval: no gold set at {eval_path}")
    cases = yaml.load(eval_path.read_text(), Loader=StrLoader) or []
    scored = [c for c in cases if c.get("expect")]
    if not scored:
        sys.exit("kb eval: gold set has no cases with expectations")
    if args.recall:
        # auto-recall calibration: fire on KB-relevant prompts, stay silent on
        # the no-hit set. This is the registration gate for the recall hook.
        nohit = [c for c in cases if not c.get("expect")]
        def fires_correctly(case) -> bool:
            for r in recall_candidates(root, con, str(case["q"])):
                # a claim hit is correct when the episode backing it is expected
                if r["id"] in case["expect"] or (set(r.get("episodes") or []) & set(case["expect"])):
                    return True
            return False

        hit = sum(1 for c in scored if fires_correctly(c))
        fires = sum(1 for c in nohit
                    if recall_candidates(root, con, str(c["q"])))
        print(f"kb eval --recall: hit-rate {hit}/{len(scored)} "
              f"({hit / len(scored):.2f}) · false-fires {fires}/{len(nohit)} "
              f"on the no-hit set (thresholds: cos>={RECALL_COS_MIN}, "
              f"bm25>={RECALL_BM25_MIN})")
        return 1 if fires else 0
    has_vecs = con.execute("SELECT 1 FROM vectors LIMIT 1").fetchone()
    modes = [args.mode] if args.mode != "all" else (
        ["lexical", "vector", "hybrid"] if has_vecs else ["lexical"])
    id_of = {r[0]: r[1] for r in con.execute(
        "SELECT path, id FROM meta WHERE id IS NOT NULL")}
    results: dict[str, float] = {}
    print(f"kb eval: {len(scored)} scored case(s), "
          f"{len(cases) - len(scored)} no-hit case(s) held for recall calibration")
    print(f"{'mode':<8} {'MRR@10':>7} {'R@1':>6} {'R@5':>6}")
    for mode in modes:
        mrr = r1 = r5 = 0.0
        for c in scored:
            _, cand, _, _ = ranked_paths(root, con, str(c["q"]), mode)
            ids = []
            for p, _ in cand:
                x = id_of.get(p)
                if x and "#" in x:
                    x = x.split("#")[0]  # a claim hit counts for its episode
                if x and x not in ids:
                    ids.append(x)
            ids = ids[:10]
            rank = next((i + 1 for i, x in enumerate(ids) if x in c["expect"]), None)
            if rank:
                mrr += 1.0 / rank
                r1 += rank == 1
                r5 += rank <= 5
        n = len(scored)
        results[mode] = mrr / n
        print(f"{mode:<8} {mrr / n:>7.3f} {r1 / n:>6.2f} {r5 / n:>6.2f}")
    rc = 0
    for mode in modes:
        row = con.execute("SELECT v FROM kv WHERE k = ?", (f"eval_mrr_{mode}",)).fetchone()
        if args.save_baseline:
            con.execute("INSERT OR REPLACE INTO kv VALUES (?, ?)",
                        (f"eval_mrr_{mode}", f"{results[mode]:.4f}"))
            con.commit()
        elif row and results[mode] < float(row[0]) - 0.02:
            print(f"REGRESSION: {mode} MRR {results[mode]:.3f} < baseline {row[0]}")
            rc = 1
    if args.save_baseline:
        print("baselines saved")
    return rc


# ---------------------------------------------------------------------- show

def resolve(root: Path, ref: str) -> Path:
    if ref.startswith("kb:/"):
        p = from_kb_uri(root, ref)
        if p.is_file():
            return p
        sys.exit(f"kb: no file at {ref}")
    p = Path(ref)
    if p.is_file():
        return p
    # bare id — try the index first, fall back to a filesystem scan
    con = open_db(root)
    row = con.execute("SELECT path FROM meta WHERE id = ?", (ref,)).fetchone()
    if row:
        f = from_kb_uri(root, row[0])
        if f.is_file():
            return f
    hits = [f for f in walk_md(root)
            if (parse_fm(f)[0] or {}).get("id") == ref]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        sys.exit(f"kb: no entry with id '{ref}'")
    sys.exit("kb: ambiguous id, candidates:\n" + "\n".join(str(h) for h in hits))


def cmd_show(args) -> int:
    root = kb_root()
    p = resolve(root, args.ref)
    if args.path:
        print(p)
    else:
        print(p.read_text(), end="")
    return 0


# --------------------------------------------------------------------- edges

def cmd_edges(args) -> int:
    root = kb_root()
    con = ensure_index(root)

    def describe(target: str) -> str:
        if target.startswith("kb:/"):
            row = con.execute("SELECT title, status FROM meta WHERE path = ?",
                              (target,)).fetchone()
        else:
            row = con.execute("SELECT title, status FROM meta WHERE id = ?",
                              (target,)).fetchone()
        if not row:
            return f"{target}  (MISSING)"
        title, status = row
        tag = "" if status in (None, "active") else f" [{status}]"
        return f"{target}  — {title}{tag}"

    rid = args.id
    fwd = con.execute("SELECT kind, target FROM edges WHERE src = ? ORDER BY kind",
                      (rid,)).fetchall()
    rev = con.execute(
        "SELECT kind, src FROM edges WHERE target = ? OR target = "
        "(SELECT path FROM meta WHERE id = ?) ORDER BY kind", (rid, rid)).fetchall()
    if args.json:
        def jdesc(ref: str) -> dict:
            row = con.execute(
                "SELECT title, status FROM meta WHERE path = ? OR id = ?",
                (ref, ref)).fetchone()
            return {"ref": ref, "title": row[0] if row else None,
                    "status": row[1] if row else None, "missing": row is None}
        print(json.dumps({
            "forward": [{"kind": k, **jdesc(t)} for k, t in fwd],
            "reverse": [{"kind": k, **jdesc(s)} for k, s in rev],
        }, indent=2, ensure_ascii=False))
        return 0
    if not fwd and not rev:
        print(f"no edges for '{rid}'")
        return 0
    if fwd:
        print("forward:")
        for kind, target in fwd:
            print(f"  {kind:>14}: {describe(target)}")
    if rev:
        print("reverse (what links here):")
        for kind, src in rev:
            print(f"  {kind:>14}: {describe(src)}")
    return 0


# -------------------------------------------------------------------- routes

def recipe_trigger_lines(root: Path) -> list[str]:
    """One `when_to_use` line per recipe — what /start and ambient match on."""
    out: list[str] = []
    rec_dir = root / "recipes"
    if rec_dir.is_dir():
        for p in sorted(rec_dir.glob("*.md")):
            if p.name == "_route.md":
                continue
            fm, _ = parse_fm(p)
            if fm and fm.get("type") == "recipe":
                tag = "" if fm.get("status") == "active" else f" [{fm.get('status')}]"
                out.append(f"  {fm.get('id')}{tag}: {first_line(fm.get('when_to_use'), 150)}")
    return out


def cmd_routes(args) -> int:
    root = kb_root()
    routes = [p for p in walk_md(root) if p.name == "_route.md"]
    nentries = 0
    chars = 0

    if args.compact:
        out: list[str] = []
        for rp in routes:
            fm, _ = parse_fm(rp)
            if fm is None:
                continue
            folder = fm.get("folder", to_kb_uri(root, rp.parent))
            out.append(f"{folder} — {first_line(fm.get('purpose'), 150)}")
            for ent in fm.get("entries") or []:
                if not isinstance(ent, dict):
                    continue
                nentries += 1
                out.append(f"  {ent.get('id')} — {first_line(ent.get('summary'), 120)}")
            out.append("")
        # recipes get their trigger line too — that's what /start matches on
        rec = recipe_trigger_lines(root)
        if rec:
            out.append("recipe triggers (when_to_use):")
            out.extend(rec)
        text = "\n".join(out)
        print(text)
        chars = len(text)
        print(f"\nBASELINE: level=compact routes={len(routes)} entries={nentries} "
              f"chars={chars} est_tokens={chars // 4}")
        return 0

    for rp in routes:
        text = rp.read_text()
        chars += len(text)
        print(f"===== {to_kb_uri(root, rp)} =====")
        print(text)
        nentries += len(re.findall(r"^\s*- id:", text, re.M))

    if args.deep:
        nleaves = 0
        for p in walk_md(root):
            if p.name == "_route.md":
                continue
            text = p.read_text()
            end = text.index("\n---\n", 4) + 5 if text.startswith("---\n") and "\n---\n" in text else len(text)
            fm_text = text[:end]
            chars += len(fm_text)
            nleaves += 1
            print(f"===== {to_kb_uri(root, p)} =====")
            print(fm_text)
        print(f"BASELINE: level=deep routes={len(routes)} entries={nentries} "
              f"leaves={nleaves} chars={chars} est_tokens={chars // 4}")
    else:
        print(f"BASELINE: level=route routes={len(routes)} entries={nentries} "
              f"chars={chars} est_tokens={chars // 4}")
    return 0


# ------------------------------------------------------------ reindex-routes

def ydump(v: object) -> str:
    """One-line YAML scalar."""
    s = yaml.safe_dump(v, default_flow_style=True, allow_unicode=True,
                       width=10 ** 6).strip()
    if s.endswith("\n..."):
        s = s[: -4].strip()
    return s


def yflow(items: list) -> str:
    return "[" + ", ".join(ydump(i) for i in items) + "]"


ROUTE_KNOWN_KEYS = frozenset({"type", "folder", "title", "purpose", "last_indexed",
                              "topics", "subroutes", "entries", "related"})


def emit_route(fm: dict, body: str) -> str:
    lines = ["---", "type: route",
             f"folder: {fm['folder']}",
             f"title: {ydump(fm.get('title') or '')}",
             f"purpose: {ydump(fm.get('purpose') or '')}",
             f"last_indexed: {fm['last_indexed']}",
             f"topics: {yflow(fm.get('topics') or [])}"]
    subs = fm.get("subroutes") or []
    lines.append("subroutes:" if subs else "subroutes: []")
    for s in subs:
        lines.append(f"  - path: {s['path']}")
        lines.append(f"    summary: {ydump(s.get('summary') or '')}")
    ents = fm.get("entries") or []
    lines.append("entries:" if ents else "entries: []")
    for e in ents:
        lines.append(f"  - id: {e['id']}")
        lines.append(f"    file: {e['file']}")
        lines.append(f"    summary: {ydump(e.get('summary') or '')}")
    rel = fm.get("related") or []
    lines.append("related:" if rel else "related: []")
    for r in rel:
        lines.append(f"  - {r}")
    # round-trip anything we don't own — hand-added route metadata must survive sync
    extra = {k: v for k, v in fm.items() if k not in ROUTE_KNOWN_KEYS}
    if extra:
        lines.append(yaml.safe_dump(extra, sort_keys=False, allow_unicode=True,
                                    width=10 ** 6).strip())
    lines.append("---")
    return "\n".join(lines) + "\n" + body


def cmd_reindex_routes(args) -> int:
    root = kb_root()
    quiet = getattr(args, "quiet", False)
    now = now_iso()
    changed = 0
    for rp in [p for p in walk_md(root) if p.name == "_route.md"]:
        fm, body = parse_fm(rp)
        if fm is None:
            print(f"kb reindex-routes: SKIP unparseable {rp}", file=sys.stderr)
            continue
        folder = rp.parent
        fm["folder"] = to_kb_uri(root, folder)

        # --- entries[]: derived from the leaves actually on disk -------------
        old_entries = {e.get("id"): e for e in (fm.get("entries") or [])
                       if isinstance(e, dict)}
        new_entries = []
        leaf_topics: list[list[str]] = []
        for leaf in sorted(folder.glob("*.md")):
            if leaf.name == "_route.md":
                continue
            lfm, _ = parse_fm(leaf)
            if lfm is None or not lfm.get("id"):
                continue
            lid = lfm["id"]
            prev = old_entries.get(lid)
            # keep the (possibly curated) one-liner; derive one for new leaves
            summary = (prev or {}).get("summary") or first_line(lfm.get("summary"), 100)
            new_entries.append({"id": lid, "file": to_kb_uri(root, leaf),
                                "summary": summary})
            leaf_topics.append([str(t) for t in (lfm.get("topics") or [])])
        # preserve curated order for kept ids, append new ones (sorted) at the end
        kept = [e for e in (fm.get("entries") or [])
                if isinstance(e, dict) and any(n["id"] == e.get("id") for n in new_entries)]
        kept_ids = {e.get("id") for e in kept}
        ordered = [next(n for n in new_entries if n["id"] == e.get("id")) for e in kept]
        ordered += [n for n in new_entries if n["id"] not in kept_ids]

        # --- subroutes: every child dir present, curated summaries kept ------
        old_subs = {s.get("path"): s for s in (fm.get("subroutes") or [])
                    if isinstance(s, dict)}
        found_subs = {}
        for child in sorted(p for p in folder.iterdir()
                            if p.is_dir() and not p.name.startswith(".")):
            child_route = child / "_route.md"
            if not child_route.is_file():
                continue
            uri = to_kb_uri(root, child_route)
            prev = old_subs.get(uri)
            if prev and prev.get("summary"):
                summary = prev["summary"]
            else:
                cfm, _ = parse_fm(child_route)
                summary = first_line((cfm or {}).get("purpose"), 100) or child.name
            found_subs[uri] = {"path": uri, "summary": summary}
        # curated order for kept paths, new children appended (sorted)
        new_subs = [found_subs[s["path"]] for s in (fm.get("subroutes") or [])
                    if isinstance(s, dict) and s.get("path") in found_subs]
        new_subs += [v for k, v in found_subs.items()
                     if k not in {s["path"] for s in new_subs}]

        # --- topics: keep existing; add tags shared by >=2 direct leaves -----
        topics = [str(t) for t in (fm.get("topics") or [])]
        counts: dict[str, int] = {}
        for ts in leaf_topics:
            for t in set(ts):
                counts[t] = counts.get(t, 0) + 1
        for t, c in sorted(counts.items()):
            if c >= 2 and t not in topics:
                topics.append(t)

        new_fm = dict(fm)
        new_fm.update(entries=ordered, subroutes=new_subs, topics=topics)
        dirty = (ordered != (fm.get("entries") or [])
                 or new_subs != (fm.get("subroutes") or [])
                 or topics != [str(t) for t in (fm.get("topics") or [])]
                 or fm.get("folder") != new_fm["folder"])
        new_fm["last_indexed"] = now if dirty else fm.get("last_indexed") or now
        out = emit_route(new_fm, body)
        if out != rp.read_text():
            changed += 1
            if args.dry_run:
                print(f"would rewrite {to_kb_uri(root, rp)}")
            else:
                rp.write_text(out)
    verb = "would rewrite" if args.dry_run else "rewrote"
    if not quiet:
        print(f"kb reindex-routes: {verb} {changed} route file(s)")
    return 0


# ---------------------------------------------------------------------- sync

def cmd_sync(args) -> int:
    rc = cmd_reindex_routes(argparse.Namespace(dry_run=False))
    audit = engine_dir() / "scripts" / "audit-topics.py"
    if audit.exists():
        r = subprocess.run(["uv", "run", "--quiet", str(audit), "--fix"],
                           capture_output=True, text=True)
        tail = (r.stdout or "").strip().splitlines()
        if tail:
            print(tail[-1])
    cmd_index(argparse.Namespace(rebuild=False, quiet=args.quiet))
    return rc


# -------------------------------------------------------------------- doctor

def cmd_doctor(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    problems = 0

    def report(kind: str, msg: str):
        nonlocal problems
        problems += 1
        print(f"  {kind:<12} {msg}")

    print("kb doctor:")
    ids = {r[0] for r in con.execute("SELECT id FROM meta WHERE id IS NOT NULL")}
    # broken bare-id references
    for src, kind, target in con.execute(
            "SELECT src, kind, target FROM edges WHERE kind != 'related'"):
        if target not in ids:
            report("broken-ref", f"{src} {kind} -> '{target}' (no such id)")
    # broken kb:/ related links
    for src, kind, target in con.execute(
            "SELECT src, kind, target FROM edges WHERE kind = 'related'"):
        if target.startswith("kb:/") and not from_kb_uri(root, target).exists():
            report("broken-link", f"{src} related -> {target} (missing on disk)")
    # recipe staleness + evidence drift
    now = datetime.now(timezone.utc)
    entry_rows = con.execute(
        "SELECT id, created, topics FROM meta WHERE doctype = 'entry' "
        "AND (status IS NULL OR status = 'active') AND id IS NOT NULL").fetchall()
    for p in walk_md(root):
        fm, _ = parse_fm(p)
        if not fm or fm.get("type") != "recipe":
            continue
        rid = fm.get("id")
        lv = fm.get("last_verified")
        # evidence drift: newer episodes in this recipe's topic area since it was
        # last looked at — its current-state claims may be outdated even if the
        # age-based check hasn't fired yet
        if fm.get("status") == "active":
            # ref = the last time anyone looked at this recipe (verified OR edited);
            # entries already folded in via derived_from are not drift
            ref = max(str(lv or ""), str(fm.get("updated") or ""),
                      str(fm.get("created") or ""))
            folded = {str(x) for x in (fm.get("derived_from") or [])}
            rtopics = {str(t) for t in (fm.get("topics") or [])}
            newer = [(eid, ec) for eid, ec, et in entry_rows
                     if ec and ec > ref and eid not in folded and len(rtopics & {
                         t.strip() for t in (et or "").split(",") if t.strip()}) >= 2]
            if newer:
                latest = max(newer, key=lambda x: x[1])[0]
                basis = "last_verified" if lv else "last update"
                report("drift-risk",
                       f"{rid}: {len(newer)} newer entr"
                       f"{'y shares' if len(newer) == 1 else 'ies share'} "
                       f"≥2 of its topics since {basis} (latest: {latest}) — "
                       f"re-verify its claims or fold the new evidence in")
        if fm.get("status") == "draft":
            created = fm.get("created") or ""
            try:
                age = (now - datetime.strptime(created, "%Y-%m-%dT%H:%M:%SZ")
                       .replace(tzinfo=timezone.utc)).days
            except ValueError:
                age = -1
            if age > 30:
                report("stale-draft", f"{rid} has been draft for {age}d — verify or drop")
        elif lv is None:
            report("unverified", f"{rid} active but last_verified is null")
        else:
            try:
                age = (now - datetime.strptime(lv, "%Y-%m-%dT%H:%M:%SZ")
                       .replace(tzinfo=timezone.utc)).days
                if age > args.recipe_max_age:
                    report("stale-recipe", f"{rid} last verified {age}d ago")
            except ValueError:
                report("bad-date", f"{rid} last_verified unparseable: {lv!r}")
    # model hygiene: the Popperian loop must not silt up
    for p in walk_md(root):
        fm, _ = parse_fm(p)
        if not fm or fm.get("type") != "model":
            continue
        mid = fm.get("id")
        status = fm.get("status")
        if status == "refuted" and not fm.get("refuted_by"):
            report("bad-model", f"{mid} refuted but refuted_by is empty")
        if status == "corroborated" and not fm.get("evidence_for"):
            report("bad-model", f"{mid} corroborated but evidence_for is empty")
        if status in ("hypothesis", "corroborated") and fm.get("refuted_by"):
            report("needs-review",
                   f"{mid} is {status} but has refuted_by evidence — refute it or narrow the statement")
        if not fm.get("derived_from"):
            report("ungrounded", f"{mid} has no derived_from — a model with no grounding episodes")
        if status == "hypothesis":
            created = fm.get("created") or ""
            try:
                age = (now - datetime.strptime(created, "%Y-%m-%dT%H:%M:%SZ")
                       .replace(tzinfo=timezone.utc)).days
            except ValueError:
                age = -1
            if age > args.model_max_age and not fm.get("evidence_for"):
                report("stale-model",
                       f"{mid} hypothesis for {age}d untested — run /criticize (rival + crucial experiment) or drop")
    # problem queue: open conflicts are where knowledge growth starts — surface, don't fix
    live = {r[0]: r[1] for r in con.execute(
        "SELECT id, status FROM meta WHERE id IS NOT NULL")}
    live_entry = {"active", None}
    for src, target in con.execute(
            "SELECT DISTINCT src, target FROM edges WHERE kind = 'contradicts'"):
        if live.get(src) in live_entry and live.get(target) in live_entry:
            report("problem",
                   f"{src} contradicts {target}, both active — unresolved conflict; "
                   f"a resolution is usually a boundary condition (/theorize)")
    live_model = {"hypothesis", "corroborated"}
    seen_pairs = set()
    for src, target in con.execute(
            "SELECT DISTINCT src, target FROM edges WHERE kind = 'rivals'"):
        pair = tuple(sorted((src, target)))
        if pair in seen_pairs:
            continue
        seen_pairs.add(pair)
        if live.get(src) in live_model and live.get(target) in live_model:
            report("problem",
                   f"{pair[0]} vs {pair[1]} — live rivals; a crucial experiment "
                   f"should kill one (/criticize proposes it)")
    # claim layer: conflicts (same key, same day, different value), weak
    # supersession (a reported/inferred claim overriding an observed one), and
    # staleness by the subject's decay class
    vocab = load_subjects(root)
    today = datetime.now(timezone.utc).date()
    con.row_factory = sqlite3.Row
    allc = con.execute("SELECT * FROM claims ORDER BY subject, scope, since, asserted").fetchall()
    con.row_factory = None
    by_key: dict[tuple, list] = {}
    for r in allc:
        by_key.setdefault((r["subject"], r["scope"]), []).append(r)
    for (subj, scope), chain in by_key.items():
        key = subj + (f" [{scope}]" if scope else "")
        for a, b in zip(chain, chain[1:]):
            if (a["since"] == b["since"] and a["value_norm"] != b["value_norm"]
                    and not is_restatement(a["value_norm"], b["value_norm"])):
                report("conflict", f"{key}: {a['episode']} says {a['value']!r} but "
                                   f"{b['episode']} says {b['value']!r} on the same date — "
                                   f"one is wrong or the scope is missing")
        for r in chain:
            if r["superseded_by"] and r["value_norm"] != next(
                    (x["value_norm"] for x in chain if x["path"] == r["superseded_by"]), r["value_norm"]):
                nxt = next((x for x in chain if x["path"] == r["superseded_by"]), None)
                if nxt and r["kind"] == "observed" and nxt["kind"] != "observed":
                    report("weak-superseded",
                           f"{key}: observed {first_line(r['value'], 60)!r} ({r['episode']}) "
                           f"overridden by {nxt['kind']} {first_line(nxt['value'], 60)!r} "
                           f"({nxt['episode']}) — verify, or split the subject if these are "
                           f"different facts")
        cur = [r for r in chain if r["valid_to"] is None]
        for r in cur:
            half = subject_decay_days(vocab, subj)
            if not half:
                continue
            ref = r["confirmed"] or r["since"]
            try:
                age = (today - datetime.strptime(ref, "%Y-%m-%d").date()).days
            except ValueError:
                continue
            if age > half:
                report("stale-claim", f"{key} = {first_line(r['value'], 55)!r} unconfirmed for "
                                      f"{age}d (decay {half}d) — re-verify or supersede")
    for subj in sorted({r["subject"] for r in allc}):
        if subj not in vocab["subjects"]:
            report("unknown-subject", f"{subj} used by a claim but not in _subjects.yaml — run `kb sync`")
    # route drift: leaf on disk newer than its route's last_indexed
    for rp in [p for p in walk_md(root) if p.name == "_route.md"]:
        fm, _ = parse_fm(rp)
        if not fm:
            continue
        listed = {e.get("id") for e in (fm.get("entries") or []) if isinstance(e, dict)}
        on_disk = set()
        for leaf in rp.parent.glob("*.md"):
            if leaf.name == "_route.md":
                continue
            lfm, _ = parse_fm(leaf)
            if lfm and lfm.get("id"):
                on_disk.add(lfm["id"])
        if listed != on_disk:
            report("route-drift",
                   f"{to_kb_uri(root, rp)} entries[] != leaves on disk — run `kb sync`")
    if problems == 0:
        print("  all clear")
    return 1 if problems else 0


# ------------------------------------------------------------------ problems
#
# The epistemic ledger: kb doctor *notices* open conflicts; problem leaves under
# kb:/problems/ make them durable, with a lifecycle (open -> ready -> resolved |
# dropped). /criticize upgrades a stub to `ready` by writing the pre-registered
# crucial experiment; /run-experiment executes it and resolves. The CLI only does
# the mechanical parts: reconciling doctor findings into stubs, listing, briefing,
# and field edits at resolution time. Judgment stays with the LLM layer.

PROBLEM_AGE_FMT = "%Y-%m-%dT%H:%M:%SZ"


def problems_dir(root: Path) -> Path:
    return root / "problems"


def age_days(iso: object) -> int:
    try:
        return (datetime.now(timezone.utc)
                - datetime.strptime(str(iso), PROBLEM_AGE_FMT)
                .replace(tzinfo=timezone.utc)).days
    except ValueError:
        return -1


def load_problems(root: Path) -> list[tuple[Path, dict, str]]:
    d = problems_dir(root)
    if not d.is_dir():
        return []
    out = []
    for p in sorted(d.glob("*.md")):
        if p.name == "_route.md":
            continue
        fm, body = parse_fm(p)
        if fm and fm.get("type") == "problem":
            out.append((p, fm, body))
    return out


def write_problem(path: Path, fm: dict, body: str) -> None:
    """Fixed serializer for machine-managed problem leaves."""
    fm_text = yaml.safe_dump(fm, sort_keys=False, allow_unicode=True,
                             width=100, default_flow_style=False).strip()
    path.write_text(f"---\n{fm_text}\n---\n\n{body.strip()}\n")


def epistemic_findings(root: Path, con: sqlite3.Connection,
                       model_max_age: int = 60) -> list[dict]:
    """The doctor conditions that deserve a durable ledger entry.

    Mirrors cmd_doctor's problem/needs-review/stale-model logic; returns
    structured findings instead of printed lines.
    """
    live = {r[0]: r[1] for r in con.execute(
        "SELECT id, status FROM meta WHERE id IS NOT NULL")}
    live_model = {"hypothesis", "corroborated"}
    live_entry = {"active", None}
    findings: list[dict] = []
    rival_ids: set[str] = set()
    seen_pairs = set()
    for src, target in con.execute(
            "SELECT DISTINCT src, target FROM edges WHERE kind = 'rivals'"):
        pair = tuple(sorted((src, target)))
        if pair in seen_pairs:
            continue
        seen_pairs.add(pair)
        if live.get(pair[0]) in live_model and live.get(pair[1]) in live_model:
            rival_ids.update(pair)
            findings.append({"kind": "rivals", "ids": list(pair),
                             "fingerprint": f"rivals:{pair[0]}|{pair[1]}"})
    for src, target in con.execute(
            "SELECT DISTINCT src, target FROM edges WHERE kind = 'contradicts'"):
        pair = tuple(sorted((src, target)))
        if live.get(pair[0]) in live_entry and live.get(pair[1]) in live_entry:
            fp = f"contradiction:{pair[0]}|{pair[1]}"
            if fp not in {f["fingerprint"] for f in findings}:
                findings.append({"kind": "contradiction", "ids": list(pair),
                                 "fingerprint": fp})
    for p in walk_md(root):
        fm, _ = parse_fm(p)
        if not fm or fm.get("type") != "model":
            continue
        mid = fm.get("id")
        status = fm.get("status")
        if status in live_model and fm.get("refuted_by"):
            findings.append({"kind": "refuted-review", "ids": [mid],
                             "fingerprint": f"refuted-review:{mid}"})
        elif (status == "hypothesis" and not fm.get("evidence_for")
              and mid not in rival_ids
              and age_days(fm.get("created")) > model_max_age):
            # a lone hypothesis sitting untested — /criticize owes it a rival
            # and/or its riskiest-prediction experiment
            findings.append({"kind": "open-question", "ids": [mid],
                             "fingerprint": f"untested:{mid}"})
    return findings


def _stub_fields(root: Path, con: sqlite3.Connection, f: dict) -> tuple[str, str, str]:
    """(slug, title, body) for a scan-minted stub."""
    kind, ids = f["kind"], f["ids"]
    if kind == "rivals":
        slug = f"rivals-{ids[0]}-vs-{ids[1]}"
        title = f"{ids[0]} vs {ids[1]} — undiscriminated rivals"
    elif kind == "contradiction":
        slug = f"contradiction-{ids[0]}-vs-{ids[1]}"
        title = f"{ids[0]} contradicts {ids[1]} — unresolved"
    elif kind == "refuted-review":
        slug = f"refuted-review-{ids[0]}"
        title = f"{ids[0]} carries refutation evidence — refute or narrow"
    else:
        slug = f"untested-{ids[0]}"
        title = f"{ids[0]} is an untested lone hypothesis"
    lines = ["Minted by `kb problems scan` from a standing `kb doctor` finding.", ""]
    for i in ids:
        row = con.execute("SELECT path, status FROM meta WHERE id = ?", (i,)).fetchone()
        claim = ""
        if row:
            fm, _ = parse_fm(from_kb_uri(root, row[0]))
            claim = first_line((fm or {}).get("statement") or (fm or {}).get("summary"), 200)
        lines.append(f"- **{i}**" + (f" ({row[1]})" if row and row[1] else "") +
                     (f": {claim}" if claim else ""))
    lines += ["",
              "Next: `/criticize` designs the crucial experiment (pre-registered "
              "observation + outcomes) and upgrades this problem to `ready`; "
              "`/run-experiment` executes it."]
    return slug, title, "\n".join(lines)


def ensure_problems_route(root: Path) -> None:
    d = problems_dir(root)
    d.mkdir(exist_ok=True)
    rp = d / "_route.md"
    if rp.exists():
        return
    rp.write_text(f"""---
type: route
folder: kb:/problems
title: Problems
purpose: The epistemic ledger — open conflicts in the theory layer (undiscriminated rivals, refutation evidence, contradictions), each carrying its pre-registered crucial experiment once /criticize has designed it. Resolution is the KB's growth metric.
last_indexed: {now_iso()}
topics: []
subroutes: []
entries: []
related:
  - kb:/models/_route.md
---

# Problems

Stubs are minted deterministically by `kb problems scan` from `kb doctor` findings;
`/criticize` upgrades them to `ready` with a pre-registered experiment;
`/run-experiment` runs the observation and resolves them. Never resolve without a
filed episode as evidence.
""")


def problems_brief_text(root: Path, probs=None) -> str:
    """The compact ambient block; empty string when no live problems."""
    if probs is None:
        probs = load_problems(root)
    live = [(p, fm) for p, fm, _ in probs if fm.get("status") in ("open", "ready")]
    if not live:
        return ""
    ready = [(p, fm) for p, fm in live if fm.get("status") == "ready"]
    oldest = max(age_days(fm.get("created")) for _, fm in live)
    resolved_30d = sum(1 for _, fm, _ in probs
                       if fm.get("status") == "resolved"
                       and 0 <= age_days(fm.get("updated")) <= 30)
    out = [f"OPEN PROBLEMS (theory layer): {len(live) - len(ready)} open · "
           f"{len(ready)} ready to run · oldest {oldest}d · "
           f"{resolved_30d} resolved in last 30d"]
    for _, fm in sorted(ready, key=lambda x: age_days(x[1].get("created")),
                        reverse=True)[:3]:
        exp = fm.get("experiment") or {}
        out.append(f"  READY {fm.get('id')} ({age_days(fm.get('created'))}d, "
                   f"{exp.get('decisiveness', '?')}): "
                   f"{first_line(exp.get('observation'), 100)}")
    if ready:
        out.append(f"  Run one now: /run-experiment <id>"
                   + (f" ({len(ready) - 3} more: kb problems list --status ready)" if len(ready) > 3 else ""))
    else:
        out.append("  No experiments designed yet — /criticize turns open problems "
                   "into ready ones.")
    return "\n".join(out)


def cmd_problems(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    action = args.action

    if action == "scan":
        findings = epistemic_findings(root, con, model_max_age=args.model_max_age)
        existing = {fm.get("fingerprint"): (p, fm) for p, fm, _ in load_problems(root)}
        created, inversions, cleared = 0, 0, 0
        if findings:
            ensure_problems_route(root)
        for f in findings:
            hit = existing.get(f["fingerprint"])
            if hit is None:
                slug, title, body = _stub_fields(root, con, f)
                path = problems_dir(root) / f"{slug}.md"
                if path.exists():
                    print(f"  SKIP {slug}: file exists without matching fingerprint",
                          file=sys.stderr)
                    continue
                topics: list[str] = []
                for i in f["ids"]:
                    row = con.execute("SELECT topics FROM meta WHERE id = ?", (i,)).fetchone()
                    for t in (row[0] if row else "").split(","):
                        t = t.strip()
                        if t and t not in topics and len(topics) < 8:
                            topics.append(t)
                related = []
                for i in f["ids"]:
                    row = con.execute("SELECT path FROM meta WHERE id = ?", (i,)).fetchone()
                    if row:
                        related.append(row[0])
                write_problem(path, {
                    "type": "problem", "id": slug, "title": title,
                    "created": now_iso(), "updated": now_iso(),
                    "status": "open", "kind": f["kind"],
                    "fingerprint": f["fingerprint"], "models": f["ids"],
                    "experiment": None, "resolved_by": None, "resolution": None,
                    "topics": topics, "related": related, "sources": [],
                    "summary": f"{title}. Standing doctor finding made durable; "
                               f"needs a pre-registered crucial experiment "
                               f"(/criticize), then /run-experiment.",
                }, body)
                created += 1
                print(f"  minted {slug} ({f['kind']})")
            elif hit[1].get("status") in ("resolved", "dropped"):
                inversions += 1
                print(f"  INVERSION {hit[1].get('id')}: marked "
                      f"{hit[1].get('status')} but the doctor condition still fires — "
                      f"the resolution didn't take, or edges weren't updated")
        firing = {f["fingerprint"] for f in findings}
        for p, fm, _ in load_problems(root):
            if fm.get("status") in ("open", "ready") and fm.get("fingerprint") not in firing:
                cleared += 1
                print(f"  cleared {fm.get('id')}: condition no longer fires — "
                      f"resolve it with the episode that settled it, or drop it")
        if created:
            cmd_reindex_routes(argparse.Namespace(dry_run=False))
            cmd_index(argparse.Namespace(rebuild=False, quiet=True))
        print(f"kb problems scan: {len(findings)} finding(s), {created} minted, "
              f"{inversions} inversion(s), {cleared} cleared")
        return 0

    probs = load_problems(root)

    if action == "list":
        rows = [(p, fm) for p, fm, _ in probs
                if not args.status or fm.get("status") == args.status]
        if not rows:
            print("no problems" + (f" with status {args.status}" if args.status else ""))
            return 0
        counts: dict[str, int] = {}
        for _, fm, _ in probs:
            counts[str(fm.get("status"))] = counts.get(str(fm.get("status")), 0) + 1
        for p, fm in rows:
            exp = fm.get("experiment") or {}
            extra = ""
            if fm.get("status") == "ready" and isinstance(exp, dict):
                extra = f"  [{exp.get('decisiveness', '?')}/{first_line(exp.get('cost'), 40)}]"
            if fm.get("status") == "resolved":
                extra = f"  -> {first_line(fm.get('resolution'), 60)}"
            print(f"  {fm.get('status'):<9} {age_days(fm.get('created')):>4}d  "
                  f"{fm.get('kind'):<14} {fm.get('id')}{extra}")
        print("totals: " + " · ".join(f"{v} {k}" for k, v in sorted(counts.items())))
        return 0

    if action == "brief":
        text = problems_brief_text(root, probs)
        if text:
            print(text)
        return 0

    if action in ("resolve", "drop"):
        hits = [(p, fm, body) for p, fm, body in probs if fm.get("id") == args.id]
        if not hits:
            sys.exit(f"kb problems: no problem with id '{args.id}'")
        p, fm, body = hits[0]
        if action == "resolve":
            if not args.by:
                sys.exit("kb problems resolve: --by <episode-id> is required "
                         "(resolution without filed evidence is not resolution)")
            if not con.execute("SELECT 1 FROM meta WHERE id = ?", (args.by,)).fetchone():
                sys.exit(f"kb problems resolve: --by '{args.by}' is not a KB id")
            fm.update(status="resolved", resolved_by=args.by,
                      resolution=args.note or None, updated=now_iso())
        else:
            fm.update(status="dropped", resolution=args.note or None, updated=now_iso())
        write_problem(p, fm, body)
        cmd_index(argparse.Namespace(rebuild=False, quiet=True))
        print(f"kb problems: {fm.get('id')} -> {fm['status']}"
              + (f" (by {args.by})" if action == "resolve" else ""))
        return 0

    sys.exit(f"kb problems: unknown action {action!r}")


# ------------------------------------------------------------------- ambient
#
# The SessionStart payload, tiered so global cost is O(folders), not O(entries):
#   Tier A (always): folder map + recipe triggers. (Model statements were
#     dropped 2026-09-16: 9 KB per session, cited in 8 of 134 sessions — models
#     are reached through search/recall like every other leaf.)
#   Tier B (cwd-relevant): per-entry lines ONLY for folders matching the repo
#     the session opened in (exact-token match — fails closed), newest
#     TIER_B_MAX entries per folder.
#   Tier C (deltas): problems brief, fresh nightly digest, unfiled-session queue.
# The full per-entry map stays one call away: `kb routes --compact`.

def _cwd_tokens(cwd: str) -> set[str]:
    toks = {Path(cwd).name.lower()}
    try:
        url = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                             capture_output=True, text=True, timeout=3).stdout.strip()
        if url:
            toks.add(re.sub(r"\.git$", "", url.rstrip("/").split("/")[-1]).lower())
    except Exception:
        pass
    # split compounds: acme-api -> {acme-api, acme, api}; drop short fragments
    for t in list(toks):
        toks.update(x for x in re.split(r"[-_.]", t) if len(x) >= 3)
    return {t for t in toks if len(t) >= 3}


def capture_queue_lines(root: Path, limit: int = 5) -> list[str]:
    """Unfiled-session suggestions written by the SessionEnd capture hook."""
    q = root / ".librarian" / "capture-queue.tsv"
    if not q.is_file():
        return []
    rows = []
    for line in q.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) >= 4 and 0 <= age_days(parts[0]) <= 14:
            rows.append(parts)
    rows = rows[-limit:][::-1]  # newest first
    return [f"  [{i + 1}] {r[0][:10]} \"{r[3][:80]}\" — transcript: {r[2]}"
            for i, r in enumerate(rows)]


TIER_B_MAX = 12      # newest entries shown per matched folder
TIER_B_FOLDERS = 4   # matched folders shown (name matches rank above topic matches)


def cmd_ambient(args) -> int:
    root = kb_root()
    out: list[str] = []

    routes = [(p, parse_fm(p)[0]) for p in walk_md(root) if p.name == "_route.md"]
    out.append("FOLDER MAP (per-entry detail: `kb routes --compact`; ranked search: `kb search`):")
    entry_map: dict[str, list[str]] = {}
    route_meta: list[tuple[str, list[str], dict]] = []
    for rp, fm in routes:
        if fm is None:
            continue
        folder = fm.get("folder", to_kb_uri(root, rp.parent))
        ents = [e for e in (fm.get("entries") or []) if isinstance(e, dict)]
        out.append(f"  {folder} ({len(ents)}) — {first_line(fm.get('purpose'), 100)}")
        entry_map[folder] = [f"    {e.get('id')} — {first_line(e.get('summary'), 110)}"
                             for e in ents]
        route_meta.append((folder, [str(t).lower() for t in (fm.get("topics") or [])], fm))

    rec = recipe_trigger_lines(root)
    if rec:
        out += ["", "recipe triggers (when_to_use):", *rec]

    if args.cwd:
        toks = _cwd_tokens(args.cwd)
        # models/recipes/problems are already ambient via their Tier-A blocks
        # folder-name matches first (the repo's own folder), topic matches after;
        # capped so a common topic tag cannot drag in a dozen folders
        by_name = [f for f, topics, _ in route_meta
                   if f.split("/")[-1].lower() in toks and entry_map.get(f)]
        by_topic = [f for f, topics, _ in route_meta
                    if f not in by_name and toks & set(topics) and entry_map.get(f)
                    and f.split("/")[-1].lower() not in ("models", "recipes", "problems")]
        shown = (by_name + by_topic)[:TIER_B_FOLDERS]
        if shown:
            out += ["", f"RELEVANT TO THIS REPO ({Path(args.cwd).name}) — newest entries:"]
            for f in shown:
                lines = sorted(entry_map[f], reverse=True)  # ids are date-prefixed
                out.append(f"  {f}:")
                out += lines[:TIER_B_MAX]
                if len(lines) > TIER_B_MAX:
                    out.append(f"    … {len(lines) - TIER_B_MAX} older — `kb routes --compact`")

    brief = problems_brief_text(root)
    if brief:
        out += ["", brief]

    digest = root / ".librarian" / "digest.md"
    if digest.is_file():
        import time
        if time.time() - digest.stat().st_mtime < 86400:
            # summary bullets + deltas only; the problems brief above already
            # covers the ledger, and standing findings live in `kb doctor`
            lines = digest.read_text().splitlines()
            cut = next((i for i, l in enumerate(lines)
                        if l.startswith("OPEN PROBLEMS")), len(lines))
            slim = [l for l in lines[:cut] if l.strip()][:12]
            out += ["", "LIBRARIAN DIGEST (overnight run):", *slim]

    unfiled = capture_queue_lines(root)
    if unfiled:
        out += ["", f"UNFILED SESSIONS ({len(unfiled)}) — say \"file #N\" to file one "
                    f"in the background (scripts/librarian file --transcript <path>):",
                *unfiled]

    text = "\n".join(out)
    print(text)
    print(f"\nBASELINE: level=ambient routes={len(routes)} chars={len(text)} "
          f"est_tokens={len(text) // 4}")
    return 0


# -------------------------------------------------------------------- recall
#
# Semantic auto-recall: score a raw conversational prompt against the KB and
# return at most n relevant leaves, or nothing. Cosine over HEAD vectors only
# (chunked transcript bodies are exactly the noise source for conversational
# text), unioned with a stopword-filtered BM25 leg. Session-scoped dedupe so
# the same entry is never injected twice into one session.

RECALL_STOP = frozenset("""
the and for with that this from have has was were are you your our their they
them then than what when where which while who whom whose why how can could
should would will just like also into over under about after before between
during against without within being been because but not all any some more
most other such only own same so too very s t don now let know need want make
made using use used get got run running new old good great think really
something anything nothing help please thanks maybe actually probably
question answer look looking file files code change changes fix issue
""".split())

# Calibrated against the _eval.yaml no-hit set (kb eval --recall): irrelevant
# conversational prompts top out around cos 0.31 on this corpus, so 0.40 fires
# only on real matches; a bm25-only hit needs to be either very strong (exact
# terminology) or corroborated by a near-threshold cosine.
RECALL_COS_MIN = 0.40
RECALL_COS_WEAK = 0.35
RECALL_BM25_MIN = 8.0
RECALL_BM25_STRONG = 14.0
# A lexical-only hit still needs minimal semantic agreement: BM25 scores move with
# corpus statistics (adding the claim layer shifted them), and a hit at cos 0.09 is
# unrelated by any measure. This floor is what keeps the always-on hook silent.
RECALL_COS_FLOOR = 0.15


def recall_candidates(root: Path, con, text: str, n: int = 3) -> list[dict]:
    text = re.sub(r"```.*?```", " ", text, flags=re.S)  # code blocks are noise
    live_leaf = ("AND m.doctype IN ('entry','recipe','model','problem','claim') "
                 "AND (m.status IN ('active','draft','hypothesis','corroborated',"
                 "'open','ready') OR m.status IS NULL)")
    cos: dict[str, float] = {}
    q = _embed(root, [text])
    if q is not None:
        rows = con.execute(
            f"SELECT v.path, v.vec FROM vectors v JOIN meta m ON m.path = v.path "
            f"WHERE v.kind = 'head' {live_leaf}").fetchall()
        if rows:
            import numpy as np
            mat = np.frombuffer(b"".join(r[1] for r in rows),
                                dtype=np.float32).reshape(len(rows), -1)
            cos = {path: float(s) for (path, _), s in zip(rows, mat @ q[0])}
    bm: dict[str, float] = {}
    toks = [t for t in re.findall(r"[A-Za-z0-9_-]{3,}", text.lower())
            if t not in RECALL_STOP][:24]
    if len(toks) >= 2:
        sql = (f"SELECT m.path, bm25(docs, {BM25_WEIGHTS}) AS score "
               f"FROM docs JOIN meta m ON m.path = docs.path "
               f"WHERE docs MATCH ? {live_leaf} ORDER BY score LIMIT 10")
        bm = {path: -score for path, score
              in con.execute(sql, (fts_query(" ".join(toks)),))}
    hits: dict[str, dict] = {}
    floor = float(os.environ.get("KB_EXP_RECALL_FLOOR", RECALL_COS_FLOOR))
    for path in set(cos) | set(bm):
        c, b = cos.get(path, 0.0), bm.get(path, 0.0)
        if (c >= RECALL_COS_MIN
                or (b >= RECALL_BM25_STRONG and c >= floor)
                or (b >= RECALL_BM25_MIN and c >= RECALL_COS_WEAK)):
            hits[path] = {"cos": c or None, "bm25": b or None}
    # a current claim outranks the episodes around it: it IS the answer, one line
    ranked = sorted(hits.items(),
                    key=lambda x: (0 if x[0].startswith("claim:") else 1,
                                   -(x[1]["cos"] or 0), -(x[1]["bm25"] or 0)))[:n]
    out = []
    shown_subjects: set[str] = set()
    for path, comp in ranked:
        row = con.execute(
            "SELECT m.id, m.doctype, m.title, "
            "(SELECT summary FROM docs WHERE docs.path = m.path) "
            "FROM meta m WHERE m.path = ?", (path,)).fetchone()
        if not row:
            continue
        item = {"id": row[0], "type": row[1], "title": row[2],
                "summary": first_line(row[3]), "path": leaf_path(root, con, path), **comp}
        if path.startswith("claim:"):
            # serve the whole subject (default + exceptions), once, not one claim
            subj = con.execute("SELECT subject FROM claims WHERE path = ?", (path,)).fetchone()
            if not subj or subj[0] in shown_subjects:
                continue
            shown_subjects.add(subj[0])
            cur = con.execute(
                "SELECT scope, value, since, kind, episode, source FROM claims WHERE subject = ? "
                "AND valid_to IS NULL ORDER BY length(scope), since", (subj[0],)).fetchall()
            lines = []
            for scope, value, since, kind, episode, source in cur:
                lines.append((f"[{scope}] " if scope else "") + f"{value}  (since {since}, {kind}" +
                             (f", {source}" if source else "") + f"; {episode})")
            item["id"] = subj[0]
            item["episodes"] = sorted({r[4] for r in cur})  # what a citation points at
            item["title"] = f"current facts on {subj[0]} — `kb facts {subj[0]}` for history"
            item["summary"] = " | ".join(lines)
        out.append(item)
    return out


def cmd_recall(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    text = sys.stdin.read()
    if len(text.strip()) < 20:
        return 0
    cands = recall_candidates(root, con, text, args.n)
    if args.session_id and cands:
        state_dir = root / ".index" / "recall-state"
        state_dir.mkdir(parents=True, exist_ok=True)
        state = state_dir / f"{args.session_id}.json"
        seen = set(json.loads(state.read_text())) if state.is_file() else set()
        cands = [c for c in cands if c["id"] not in seen]
        if cands:
            state.write_text(json.dumps(sorted(seen | {c["id"] for c in cands})))
    if not cands:
        return 0
    if args.json:
        print(json.dumps(cands, indent=2, ensure_ascii=False))
        return 0
    for c in cands:
        why = (f"cos={c['cos']:.2f}" if c["cos"] else "") + \
              (f" bm25={c['bm25']:.1f}" if c["bm25"] else "")
        print(f"{c['id']} ({c['type']}, {why.strip()}) — {c['title']}")
        print(f"  {c['summary']}")
        print(f"  file: {c['path']}")
    return 0


# --------------------------------------------------------------------- serve

def cmd_serve(args) -> int:
    """Exec the sibling MCP server (own PEP 723 dep block — the mcp SDK's
    dependency weight never rides along on normal kb invocations)."""
    server = engine_dir() / "scripts" / "kb-mcp"
    if not server.exists():
        sys.exit(f"kb serve: missing {server}")
    os.execvp("uv", ["uv", "run", "--quiet", str(server)])


# ---------------------------------------------------------------------- main

def main() -> int:
    ap = argparse.ArgumentParser(prog="kb", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("index", help="build/refresh the search index")
    p.add_argument("--rebuild", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(fn=cmd_index)

    p = sub.add_parser("search", help="hybrid (BM25 + vector, RRF-fused) full-text search")
    p.add_argument("query", nargs="+")
    p.add_argument("-n", type=int, default=10, help="max hits (default 10)")
    p.add_argument("--mode", choices=["hybrid", "lexical", "vector"], default="hybrid",
                   help="hybrid falls back to lexical when no vectors exist")
    p.add_argument("--type", choices=["entry", "recipe", "model", "problem", "claim", "route", "all"], default="all")
    p.add_argument("--topic", action="append", help="require a topic tag (repeatable)")
    p.add_argument("--person", action="append", help="require a participant (repeatable)")
    p.add_argument("--all-status", action="store_true",
                   help="include superseded/archived")
    p.add_argument("--routes", action="store_true", help="include _route.md hits")
    p.add_argument("--claims", action="store_true", help="include individual claims as hits (default: episodes only; `kb facts` is the claim view)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_search)

    p = sub.add_parser("file", help="write a leaf from an LLM-distilled JSON payload (deterministic writer)")
    p.add_argument("--meta", required=True, help="JSON payload path, or - for stdin")
    p.add_argument("--session", help="session JSONL path, or 'auto' (recorded by the prompt hook for --cwd)")
    p.add_argument("--cwd", help="session cwd for --session auto (default: current dir)")
    p.add_argument("--jot", action="store_true", help="no transcript: body = payload.body or summary")
    p.add_argument("--dry-run", action="store_true", help="print the frontmatter, write nothing")
    p.set_defaults(fn=cmd_file)

    p = sub.add_parser("facts", help="the claim layer: current value per (subject, scope), history, as-of")
    p.add_argument("subject", nargs="?", help="subject or prefix (e.g. mt.nn-retrieval)")
    p.add_argument("--scope", action="append", help="k=v to resolve (repeatable): most specific wins")
    p.add_argument("--as-of", help="YYYY-MM-DD: what was true then")
    p.add_argument("--history", action="store_true", help="include superseded claims")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_facts)

    p = sub.add_parser("check", help="(text on stdin) current KB claims on every subject the text touches")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_check)

    p = sub.add_parser("subjects", help="the subject vocabulary with claim counts")
    p.add_argument("--match", help="words to match against subjects and aliases")
    p.add_argument("--rename", nargs=2, metavar=("OLD", "NEW"),
                   help="merge subject OLD into NEW across all claims (curation)")
    p.add_argument("--dups", action="store_true",
                   help="group subjects sharing a segment word — likely near-duplicates to --rename")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_subjects)

    p = sub.add_parser("transcript", help="render a session JSONL as a condensed transcript")
    p.add_argument("path")
    p.add_argument("--owner", default="User", help="label for the human turns")
    p.set_defaults(fn=cmd_transcript)

    p = sub.add_parser("eval", help="retrieval quality over the _eval.yaml gold set")
    p.add_argument("--mode", choices=["all", "hybrid", "lexical", "vector"], default="all")
    p.add_argument("--save-baseline", action="store_true",
                   help="store current MRR per mode as the regression baseline")
    p.add_argument("--recall", action="store_true",
                   help="calibrate auto-recall: hit-rate on gold + false-fires on the no-hit set")
    p.set_defaults(fn=cmd_eval)

    p = sub.add_parser("ambient", help="tiered SessionStart payload (folder map + cwd-relevant entries + deltas)")
    p.add_argument("--cwd", help="session working directory (enables Tier B relevance)")
    p.set_defaults(fn=cmd_ambient)

    p = sub.add_parser("recall", help="score a prompt (stdin) against the KB; print at most n relevant leaves")
    p.add_argument("-n", type=int, default=3)
    p.add_argument("--session-id", help="dedupe state key — never re-inject the same entry in one session")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_recall)

    p = sub.add_parser("show", help="resolve an id / kb:/ URI / path and print it")
    p.add_argument("ref")
    p.add_argument("--path", action="store_true", help="print the resolved path only")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("edges", help="typed edges for an id, forward and reverse")
    p.add_argument("id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_edges)

    p = sub.add_parser("serve", help="serve the KB read-only over MCP (stdio)")
    p.add_argument("--mcp", action="store_true", help="(the only mode — explicit for clarity)")
    p.set_defaults(fn=cmd_serve)

    p = sub.add_parser("routes", help="emit the route layer + BASELINE metrics")
    p.add_argument("--compact", action="store_true",
                   help="distilled one-line-per-entry index (for ambient injection)")
    p.add_argument("--deep", action="store_true",
                   help="also emit every leaf's frontmatter")
    p.set_defaults(fn=cmd_routes)

    p = sub.add_parser("reindex-routes",
                       help="regenerate entries[]/subroutes in every _route.md from leaves")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_reindex_routes)

    p = sub.add_parser("sync", help="reindex-routes + audit-topics --fix + index")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("problems", help="the epistemic ledger (scan/list/brief/resolve/drop)")
    p.add_argument("action", choices=["scan", "list", "brief", "resolve", "drop"])
    p.add_argument("id", nargs="?", help="problem id (resolve/drop)")
    p.add_argument("--status", help="filter (list)")
    p.add_argument("--by", help="episode id holding the evidence (resolve)")
    p.add_argument("--note", help="one-line resolution note (resolve/drop)")
    p.add_argument("--model-max-age", type=int, default=60,
                   help="days before a lone untested hypothesis becomes a problem (scan)")
    p.set_defaults(fn=cmd_problems)

    p = sub.add_parser("doctor", help="staleness + referential integrity report")
    p.add_argument("--recipe-max-age", type=int, default=90,
                   help="days before an active recipe counts as stale (default 90)")
    p.add_argument("--model-max-age", type=int, default=60,
                   help="days a hypothesis may sit unconfirmed before flagging (default 60)")
    p.set_defaults(fn=cmd_doctor)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
