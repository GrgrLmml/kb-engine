#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml>=6", "numpy>=1.26", "model2vec>=0.4"]
# ///
"""kb — deterministic primitives for Gregor's knowledge base.

The LLM layer (slash commands, skills) calls these instead of traversing or
bookkeeping by hand. Everything mechanical lives here; judgment stays with the
model.

Subcommands:
  index            build/refresh the search index: FTS5 + local embeddings (incremental, by mtime)
  search QUERY     hybrid-ranked (BM25 ∪ vector, RRF) search over frontmatter + body
  eval             retrieval-quality metrics (MRR/recall) over the _eval.yaml gold set
  show ID|URI|PATH resolve an entry and print it (--path: print the path only)
  edges ID         resolved typed edges, forward AND reverse ("what links here")
  routes           emit the route layer (+ BASELINE metrics); --compact / --deep
  reindex-routes   regenerate entries[]/subroutes/last_indexed in every _route.md
                   from the leaves (purpose/related/prose stay hand-curated)
  sync             reindex-routes + audit-topics --fix + index  (post-filing one-liner)
  doctor           staleness + referential-integrity report
  problems         the epistemic ledger: scan | list | brief | resolve | drop

The index lives at $KB_DATA_DIR/.index/kb.db (gitignored, disposable — rebuilt
from the markdown at any time).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

import yaml


# --------------------------------------------------------------------- paths

def kb_root() -> Path:
    root = os.environ.get("KB_DATA_DIR") or str(
        Path(__file__).resolve().parent.parent / "kb-data")
    p = Path(root)
    if not p.exists():
        sys.exit(f"kb: KB_DATA_DIR does not exist: {p}")
    return p


def engine_dir() -> Path:
    return Path(__file__).resolve().parent.parent


def db_path(root: Path) -> Path:
    d = root / ".index"
    d.mkdir(exist_ok=True)
    return d / "kb.db"


def to_kb_uri(root: Path, p: Path) -> str:
    return "kb:/" if p == root else "kb:/" + str(p.relative_to(root))


def from_kb_uri(root: Path, uri: str) -> Path:
    rel = uri[len("kb:/"):]
    return root if rel == "" else root / rel


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --------------------------------------------------------------- frontmatter

class StrLoader(yaml.SafeLoader):
    """SafeLoader that keeps ISO timestamps as strings."""


StrLoader.yaml_implicit_resolvers = {
    k: [(tag, rx) for (tag, rx) in resolvers if tag != "tag:yaml.org,2002:timestamp"]
    for k, resolvers in StrLoader.yaml_implicit_resolvers.items()
}


def parse_fm(path: Path) -> tuple[dict | None, str]:
    """Return (frontmatter dict or None, body text)."""
    try:
        text = path.read_text()
    except Exception:
        return None, ""
    if not text.startswith("---\n"):
        return None, text
    try:
        end = text.index("\n---\n", 4)
    except ValueError:
        return None, text
    try:
        fm = yaml.load(text[4:end], Loader=StrLoader)
    except yaml.YAMLError:
        return None, text
    if not isinstance(fm, dict):
        return None, text
    return fm, text[end + 5:]


def _hidden(root: Path, p: Path) -> bool:
    return any(part.startswith(".") for part in p.relative_to(root).parts)


def walk_md(root: Path):
    for p in sorted(root.rglob("*.md")):
        if not _hidden(root, p):
            yield p


def walk_txt(root: Path):
    """Sidecar .txt artifacts (interview feedback, question sheets, …) — indexed
    as doctype 'attachment' so their content is searchable, but excluded from
    routes, doctor, and the ambient index. `_`-prefixed files are config."""
    for p in sorted(root.rglob("*.txt")):
        if not _hidden(root, p) and not p.name.startswith("_"):
            yield p


def first_line(s: object, limit: int = 200) -> str:
    """First paragraph, collapsed to one line, truncated."""
    if not isinstance(s, str) or not s.strip():
        return ""
    para = s.strip().split("\n\n")[0]
    line = " ".join(part.strip() for part in para.splitlines())
    return line if len(line) <= limit else line[: limit - 1] + "…"


# --------------------------------------------------------------------- index

# Bump SCHEMA_VERSION whenever the FTS shape or tokenizer changes: the index is
# documented-disposable, so a mismatch just drops and rebuilds it transparently.
SCHEMA_VERSION = "2"  # 2: porter stemming, attachments, vectors table

SCHEMA = """
CREATE TABLE IF NOT EXISTS meta (
  path TEXT PRIMARY KEY,        -- kb:/ URI
  mtime REAL NOT NULL,
  id TEXT,
  doctype TEXT NOT NULL,        -- entry | recipe | model | problem | route | attachment
  status TEXT,
  title TEXT,
  created TEXT,
  updated TEXT,
  topics TEXT,                  -- comma-joined
  participants TEXT
);
CREATE VIRTUAL TABLE IF NOT EXISTS docs USING fts5(
  id, title, topics, participants, summary, extra, body, path UNINDEXED,
  tokenize = 'porter unicode61'
);
CREATE TABLE IF NOT EXISTS edges (
  src TEXT NOT NULL,            -- source id
  kind TEXT NOT NULL,           -- related|supersedes|superseded_by|contradicts|derived_from|evidence_for|refuted_by|rivals|models
  target TEXT NOT NULL,         -- bare id, or kb:/ URI for related
  PRIMARY KEY (src, kind, target)
);
CREATE INDEX IF NOT EXISTS idx_edges_target ON edges(target);
CREATE TABLE IF NOT EXISTS vectors (
  path TEXT NOT NULL,           -- kb:/ URI
  kind TEXT NOT NULL,           -- 'head' | 'chunk:N'
  dim INTEGER NOT NULL,
  vec BLOB NOT NULL,            -- float32, L2-normalized at write time
  PRIMARY KEY (path, kind)
);
CREATE TABLE IF NOT EXISTS kv (k TEXT PRIMARY KEY, v TEXT);
"""


def open_db(root: Path) -> sqlite3.Connection:
    con = sqlite3.connect(db_path(root))
    con.execute("CREATE TABLE IF NOT EXISTS kv (k TEXT PRIMARY KEY, v TEXT)")
    row = con.execute("SELECT v FROM kv WHERE k = 'schema_version'").fetchone()
    if row is None or row[0] != SCHEMA_VERSION:
        # disposable by contract — drop and let the caller repopulate
        for t in ("docs", "meta", "edges", "vectors"):
            con.execute(f"DROP TABLE IF EXISTS {t}")
        con.execute("INSERT OR REPLACE INTO kv VALUES ('schema_version', ?)",
                    (SCHEMA_VERSION,))
    con.executescript(SCHEMA)
    con.commit()
    return con


def doc_fields(fm: dict, body: str, doctype: str) -> dict:
    """Flatten frontmatter into the FTS columns."""
    lst = lambda k: [str(x) for x in (fm.get(k) or []) if x is not None]
    extra_parts: list[str] = []
    for k in ("when_to_use", "purpose", "statement"):
        if isinstance(fm.get(k), str):
            extra_parts.append(fm[k])
    for k in ("steps", "decisions", "open_questions", "tools", "inputs", "predictions"):
        extra_parts.extend(lst(k))
    if doctype == "problem":
        extra_parts.append(str(fm.get("kind") or ""))
        extra_parts.append(str(fm.get("resolution") or ""))
        exp = fm.get("experiment")
        if isinstance(exp, dict):
            extra_parts.append(str(exp.get("observation") or ""))
            extra_parts.append(str(exp.get("where") or ""))
            for o in exp.get("outcomes") or []:
                if isinstance(o, dict):
                    extra_parts.append(f"{o.get('if') or ''} -> {o.get('then') or ''}")
    if doctype == "route":
        for sub in fm.get("subroutes") or []:
            if isinstance(sub, dict):
                extra_parts.append(str(sub.get("summary") or ""))
        for ent in fm.get("entries") or []:
            if isinstance(ent, dict):
                extra_parts.append(str(ent.get("summary") or ""))
    return {
        "id": str(fm.get("id") or ""),
        "title": str(fm.get("title") or ""),
        "topics": ", ".join(lst("topics")),
        "participants": ", ".join(lst("participants")),
        "summary": str(fm.get("summary") or ""),
        "extra": "\n".join(p for p in extra_parts if p),
        "body": body,
    }


def index_edges(con: sqlite3.Connection, fm: dict) -> None:
    src = fm.get("id")
    if not src:
        return
    con.execute("DELETE FROM edges WHERE src = ?", (src,))
    for kind in ("related", "supersedes", "contradicts", "derived_from",
                 "evidence_for", "refuted_by", "rivals", "models"):
        for t in fm.get(kind) or []:
            if isinstance(t, str):
                con.execute("INSERT OR IGNORE INTO edges VALUES (?,?,?)", (src, kind, t))
    sb = fm.get("superseded_by")
    if isinstance(sb, str):
        con.execute("INSERT OR IGNORE INTO edges VALUES (?,?,?)", (src, "superseded_by", sb))


# ---------------------------------------------------------------- embeddings
#
# Local static embeddings (model2vec): tokenize -> table lookup -> mean-pool.
# No torch, no ONNX runtime, ~ms per text — cheap enough to ride the incremental
# index path. Vector search is one leg of RRF fusion; BM25 is the other; the
# LLM re-ranks in-session. Model is cached under .index/model/ after the first
# (network) download; everything degrades gracefully to lexical-only without it.
# Kill switch: KB_NO_EMBED=1.

EMBED_MODEL = "minishlab/potion-retrieval-32M"


def _encoder(root: Path):
    """Lazy-load the embedding model once per process; None if unavailable."""
    if hasattr(_encoder, "_m"):
        return _encoder._m
    m = None
    if not os.environ.get("KB_NO_EMBED"):
        try:
            from model2vec import StaticModel
            cache = root / ".index" / "model" / EMBED_MODEL.split("/")[-1]
            if cache.is_dir():
                m = StaticModel.from_pretrained(str(cache))
            else:
                m = StaticModel.from_pretrained(EMBED_MODEL)  # downloads once
                cache.mkdir(parents=True, exist_ok=True)
                m.save_pretrained(str(cache))
        except Exception as e:
            print(f"kb: embeddings unavailable ({type(e).__name__}) — lexical only",
                  file=sys.stderr)
            m = None
    _encoder._m = m
    return m


def _embed(root: Path, texts: list[str]):
    """L2-normalized float32 matrix, or None when no encoder is available."""
    m = _encoder(root)
    if m is None:
        return None
    import numpy as np
    v = np.asarray(m.encode(texts), dtype=np.float32)
    if v.ndim == 1:
        v = v.reshape(1, -1)
    norms = np.linalg.norm(v, axis=1, keepdims=True)
    norms[norms == 0] = 1.0
    return v / norms


def _chunks(body: str, size: int = 1200, overlap: int = 150) -> list[str]:
    """Greedy paragraph packing; short bodies ride the head vector alone."""
    if len(body) <= 1800:
        return []
    chunks: list[str] = []
    cur = ""
    for para in body.split("\n\n"):
        if cur and len(cur) + len(para) > size:
            chunks.append(cur)
            cur = cur[-overlap:] + "\n\n" + para
        else:
            cur = f"{cur}\n\n{para}" if cur else para
    if cur.strip():
        chunks.append(cur)
    return chunks


def cmd_index(args) -> int:
    root = kb_root()
    con = open_db(root)
    # embedding-model change invalidates every vector: wipe and force re-read
    row = con.execute("SELECT v FROM kv WHERE k = 'embed_model'").fetchone()
    if row and row[0] != EMBED_MODEL:
        con.execute("DELETE FROM vectors")
        con.execute("UPDATE meta SET mtime = 0")
    known = {p: m for p, m in con.execute("SELECT path, mtime FROM meta")}
    if args.rebuild:
        con.execute("DELETE FROM meta")
        con.execute("DELETE FROM docs")
        con.execute("DELETE FROM edges")
        con.execute("DELETE FROM vectors")
        known = {}
    seen, added, refreshed = set(), 0, 0
    pending: list[tuple[str, str, list[str]]] = []  # (uri, head text, body chunks)
    for path in walk_md(root):
        uri = to_kb_uri(root, path)
        seen.add(uri)
        mtime = path.stat().st_mtime
        if uri in known and known[uri] == mtime:
            continue
        fm, body = parse_fm(path)
        if fm is None:
            continue  # invalid files are the validator's problem, not the index's
        doctype = ("route" if path.name == "_route.md"
                   else "recipe" if fm.get("type") == "recipe"
                   else "model" if fm.get("type") == "model"
                   else "problem" if fm.get("type") == "problem" else "entry")
        d = doc_fields(fm, body, doctype)
        con.execute("DELETE FROM docs WHERE path = ?", (uri,))
        con.execute(
            "INSERT INTO docs (id,title,topics,participants,summary,extra,body,path) "
            "VALUES (?,?,?,?,?,?,?,?)",
            (d["id"], d["title"], d["topics"], d["participants"],
             d["summary"], d["extra"], d["body"], uri))
        con.execute(
            "INSERT OR REPLACE INTO meta VALUES (?,?,?,?,?,?,?,?,?,?)",
            (uri, mtime, d["id"] or None, doctype, fm.get("status"),
             d["title"], fm.get("created"), fm.get("updated"),
             d["topics"], d["participants"]))
        index_edges(con, fm)
        if doctype != "route":
            head = " | ".join(x for x in (d["title"], d["topics"],
                                          d["summary"], d["extra"]) if x)
            pending.append((uri, head, _chunks(body)))
        refreshed += 1 if uri in known else 0
        added += 0 if uri in known else 1
    for path in walk_txt(root):
        uri = to_kb_uri(root, path)
        seen.add(uri)
        mtime = path.stat().st_mtime
        if uri in known and known[uri] == mtime:
            continue
        try:
            text = path.read_text()
        except Exception:
            continue
        title = path.stem.replace("-", " ")
        con.execute("DELETE FROM docs WHERE path = ?", (uri,))
        con.execute(
            "INSERT INTO docs (id,title,topics,participants,summary,extra,body,path) "
            "VALUES (?,?,?,?,?,?,?,?)", ("", title, "", "", "", "", text, uri))
        con.execute(
            "INSERT OR REPLACE INTO meta VALUES (?,?,?,?,?,?,?,?,?,?)",
            (uri, mtime, None, "attachment", None, title, None, None, "", ""))
        pending.append((uri, title, _chunks(text)))
        refreshed += 1 if uri in known else 0
        added += 0 if uri in known else 1
    if pending:
        texts, keys = [], []
        for uri, head, chunks in pending:
            texts.append(head)
            keys.append((uri, "head"))
            for i, c in enumerate(chunks):
                texts.append(c)
                keys.append((uri, f"chunk:{i}"))
        vecs = _embed(root, texts)
        if vecs is not None:
            for uri, _, _ in pending:
                con.execute("DELETE FROM vectors WHERE path = ?", (uri,))
            for (uri, kind), v in zip(keys, vecs):
                con.execute("INSERT OR REPLACE INTO vectors VALUES (?,?,?,?)",
                            (uri, kind, v.shape[0], v.tobytes()))
            con.execute("INSERT OR REPLACE INTO kv VALUES ('embed_model', ?)",
                        (EMBED_MODEL,))
    gone = set(known) - seen
    for uri in gone:
        con.execute("DELETE FROM meta WHERE path = ?", (uri,))
        con.execute("DELETE FROM docs WHERE path = ?", (uri,))
        con.execute("DELETE FROM vectors WHERE path = ?", (uri,))
    con.commit()
    n = con.execute("SELECT count(*) FROM meta").fetchone()[0]
    if not args.quiet:
        print(f"kb index: {n} docs ({added} added, {refreshed} refreshed, {len(gone)} removed)")
    return 0


def ensure_index(root: Path) -> sqlite3.Connection:
    """Open the db, refreshing it first so results are never stale."""

    class _A:
        rebuild = False
        quiet = True

    cmd_index(_A())
    return open_db(root)


# -------------------------------------------------------------------- search

def fts_query(raw: str) -> str:
    # Quoted spans become FTS phrase terms ('"recovery update"' matches adjacent
    # tokens in order); everything else stays a bag-of-words OR.
    terms: list[str] = []
    for phrase in re.findall(r'"([^"]+)"', raw):
        words = re.findall(r"[A-Za-z0-9_]+", phrase)
        if words:
            terms.append('"' + " ".join(words) + '"')
    rest = re.sub(r'"[^"]*"', " ", raw)
    terms += [f'"{t}"' for t in re.findall(r"[A-Za-z0-9_]+", rest)]
    if not terms:
        sys.exit("kb search: query has no searchable tokens")
    return " OR ".join(terms)


# column weights: id, title, topics, participants, summary, extra, body, path
BM25_WEIGHTS = "4.0, 8.0, 6.0, 3.0, 5.0, 4.0, 1.0, 0.0"

RRF_K = 60
CANDIDATES = 50  # per-leg depth feeding the fusion


def bm25_leg(con, raw_query: str, limit: int = CANDIDATES) -> list[tuple[str, float]]:
    """[(path, bm25_score_negated_better_bigger)], best first."""
    sql = (f"SELECT docs.path, bm25(docs, {BM25_WEIGHTS}) AS score "
           f"FROM docs WHERE docs MATCH ? ORDER BY score LIMIT ?")
    return [(r[0], -r[1]) for r in con.execute(sql, (fts_query(raw_query), limit))]


def vector_leg(root: Path, con, raw_query: str,
               limit: int = CANDIDATES) -> list[tuple[str, float]]:
    """[(path, cosine)], best first; doc score = max over its vectors, small
    head boost so distilled matches beat transcript-noise matches."""
    q = _embed(root, [raw_query])
    if q is None:
        return []
    rows = con.execute("SELECT path, kind, vec FROM vectors").fetchall()
    if not rows:
        return []
    import numpy as np
    mat = np.frombuffer(b"".join(r[2] for r in rows),
                        dtype=np.float32).reshape(len(rows), -1)
    scores = mat @ q[0]
    best: dict[str, float] = {}
    for (path, kind, _), s in zip(rows, scores):
        s = float(s) * (1.05 if kind == "head" else 1.0)
        if s > best.get(path, -2.0):
            best[path] = s
    return sorted(best.items(), key=lambda x: -x[1])[:limit]


def fuse_rrf(*legs: list[tuple[str, float]]) -> list[tuple[str, float]]:
    scores: dict[str, float] = {}
    for leg in legs:
        for rank, (path, _s) in enumerate(leg):
            scores[path] = scores.get(path, 0.0) + 1.0 / (RRF_K + rank + 1)
    return sorted(scores.items(), key=lambda x: -x[1])


def ranked_paths(root: Path, con, raw_query: str, mode: str) -> tuple[str, list, dict, dict]:
    """Resolve mode, run the legs, fuse. Returns (effective_mode,
    [(path, score)], bm_ranks, vec_ranks)."""
    has_vecs = con.execute("SELECT 1 FROM vectors LIMIT 1").fetchone()
    if mode == "hybrid" and not has_vecs:
        mode = "lexical"
    if mode == "vector" and not has_vecs:
        sys.exit("kb search: no vectors in the index — run `kb index` with network "
                 "access once (or unset KB_NO_EMBED)")
    bm = bm25_leg(con, raw_query) if mode in ("lexical", "hybrid") else []
    vec = vector_leg(root, con, raw_query) if mode in ("vector", "hybrid") else []
    if mode == "hybrid" and not vec:
        mode = "lexical"  # encoder unavailable right now — degrade silently
    bm_ranks = {p: i + 1 for i, (p, _) in enumerate(bm)}
    vec_ranks = {p: i + 1 for i, (p, _) in enumerate(vec)}
    if mode == "lexical":
        return mode, bm, bm_ranks, vec_ranks
    if mode == "vector":
        return mode, vec, bm_ranks, vec_ranks
    return mode, fuse_rrf(bm, vec), bm_ranks, vec_ranks


def cmd_search(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    mode, cand, bm_ranks, vec_ranks = ranked_paths(
        root, con, " ".join(args.query), args.mode)
    if not cand:
        print("no hits")
        return 1
    # filters apply post-fusion — cheap at this scale, and identical across modes
    qmarks = ",".join("?" * len(cand))
    sql = (f"SELECT m.path, m.id, m.doctype, m.status, m.title, m.created, m.topics, "
           f"(SELECT summary FROM docs WHERE docs.path = m.path) "
           f"FROM meta m WHERE m.path IN ({qmarks})")
    params: list[object] = [p for p, _ in cand]
    if args.type != "all":
        sql += " AND m.doctype = ?"
        params.append(args.type)
    elif not args.routes:
        sql += " AND m.doctype != 'route'"
    if not args.all_status:
        # active/draft are the live leaf+recipe statuses; hypothesis/corroborated the
        # live model ones; open/ready the live problem ones
        sql += (" AND (m.status IN ('active','draft','hypothesis','corroborated',"
                "'open','ready') OR m.status IS NULL)")
    for t in args.topic or []:
        sql += " AND (',' || replace(m.topics, ' ', '') || ',') LIKE ?"
        params.append(f"%,{t},%")
    for p in args.person or []:
        sql += " AND (',' || replace(m.participants, ' ', '') || ',') LIKE ?"
        params.append(f"%,{p},%")
    meta = {r[0]: r[1:] for r in con.execute(sql, params)}
    hits = [(p, s) for p, s in cand if p in meta][: args.n]
    if args.json:
        out = []
        for uri, score in hits:
            rid, doctype, status, title, created, topics, summary = meta[uri]
            out.append({"id": rid, "path": str(from_kb_uri(root, uri)), "kb_path": uri,
                        "type": doctype, "status": status, "title": title,
                        "created": created, "topics": topics,
                        "score": round(score, 4), "mode": mode,
                        "bm25_rank": bm_ranks.get(uri), "vec_rank": vec_ranks.get(uri),
                        "summary": first_line(summary)})
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0
    if not hits:
        print("no hits")
        return 1
    for uri, score in hits:
        rid, doctype, status, title, created, topics, summary = meta[uri]
        label = doctype + ("" if status in (None, "active") else f", {status}")
        shown = f"{score:6.2f}" if mode != "hybrid" else f"{score:6.4f}"
        print(f"[{shown}] {rid or uri}  ({label})")
        print(f"         file: {from_kb_uri(root, uri)}")
        print(f"         title: {title}" + (f"  ({created[:10]})" if created else ""))
        if topics:
            print(f"         topics: {topics}")
        if summary:
            print(f"         summary: {first_line(summary)}")
    return 0


# ---------------------------------------------------------------------- eval

def cmd_eval(args) -> int:
    """Retrieval quality over the gold set in $KB_DATA_DIR/_eval.yaml.

    Cases: `- q: <natural query>` + `expect: [id, ...]` (any expected id counts).
    `expect: []` rows are the no-hit calibration set (used by auto-recall
    thresholding); they're skipped for ranking metrics.
    """
    root = kb_root()
    con = ensure_index(root)
    eval_path = root / "_eval.yaml"
    if not eval_path.exists():
        sys.exit(f"kb eval: no gold set at {eval_path}")
    cases = yaml.load(eval_path.read_text(), Loader=StrLoader) or []
    scored = [c for c in cases if c.get("expect")]
    if not scored:
        sys.exit("kb eval: gold set has no cases with expectations")
    has_vecs = con.execute("SELECT 1 FROM vectors LIMIT 1").fetchone()
    modes = [args.mode] if args.mode != "all" else (
        ["lexical", "vector", "hybrid"] if has_vecs else ["lexical"])
    id_of = {r[0]: r[1] for r in con.execute(
        "SELECT path, id FROM meta WHERE id IS NOT NULL")}
    results: dict[str, float] = {}
    print(f"kb eval: {len(scored)} scored case(s), "
          f"{len(cases) - len(scored)} no-hit case(s) held for recall calibration")
    print(f"{'mode':<8} {'MRR@10':>7} {'R@1':>6} {'R@5':>6}")
    for mode in modes:
        mrr = r1 = r5 = 0.0
        for c in scored:
            _, cand, _, _ = ranked_paths(root, con, str(c["q"]), mode)
            ids = [id_of[p] for p, _ in cand if p in id_of][:10]
            rank = next((i + 1 for i, x in enumerate(ids) if x in c["expect"]), None)
            if rank:
                mrr += 1.0 / rank
                r1 += rank == 1
                r5 += rank <= 5
        n = len(scored)
        results[mode] = mrr / n
        print(f"{mode:<8} {mrr / n:>7.3f} {r1 / n:>6.2f} {r5 / n:>6.2f}")
    rc = 0
    for mode in modes:
        row = con.execute("SELECT v FROM kv WHERE k = ?", (f"eval_mrr_{mode}",)).fetchone()
        if args.save_baseline:
            con.execute("INSERT OR REPLACE INTO kv VALUES (?, ?)",
                        (f"eval_mrr_{mode}", f"{results[mode]:.4f}"))
            con.commit()
        elif row and results[mode] < float(row[0]) - 0.02:
            print(f"REGRESSION: {mode} MRR {results[mode]:.3f} < baseline {row[0]}")
            rc = 1
    if args.save_baseline:
        print("baselines saved")
    return rc


# ---------------------------------------------------------------------- show

def resolve(root: Path, ref: str) -> Path:
    if ref.startswith("kb:/"):
        p = from_kb_uri(root, ref)
        if p.is_file():
            return p
        sys.exit(f"kb: no file at {ref}")
    p = Path(ref)
    if p.is_file():
        return p
    # bare id — try the index first, fall back to a filesystem scan
    con = open_db(root)
    row = con.execute("SELECT path FROM meta WHERE id = ?", (ref,)).fetchone()
    if row:
        f = from_kb_uri(root, row[0])
        if f.is_file():
            return f
    hits = [f for f in walk_md(root)
            if (parse_fm(f)[0] or {}).get("id") == ref]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        sys.exit(f"kb: no entry with id '{ref}'")
    sys.exit("kb: ambiguous id, candidates:\n" + "\n".join(str(h) for h in hits))


def cmd_show(args) -> int:
    root = kb_root()
    p = resolve(root, args.ref)
    if args.path:
        print(p)
    else:
        print(p.read_text(), end="")
    return 0


# --------------------------------------------------------------------- edges

def cmd_edges(args) -> int:
    root = kb_root()
    con = ensure_index(root)

    def describe(target: str) -> str:
        if target.startswith("kb:/"):
            row = con.execute("SELECT title, status FROM meta WHERE path = ?",
                              (target,)).fetchone()
        else:
            row = con.execute("SELECT title, status FROM meta WHERE id = ?",
                              (target,)).fetchone()
        if not row:
            return f"{target}  (MISSING)"
        title, status = row
        tag = "" if status in (None, "active") else f" [{status}]"
        return f"{target}  — {title}{tag}"

    rid = args.id
    fwd = con.execute("SELECT kind, target FROM edges WHERE src = ? ORDER BY kind",
                      (rid,)).fetchall()
    rev = con.execute(
        "SELECT kind, src FROM edges WHERE target = ? OR target = "
        "(SELECT path FROM meta WHERE id = ?) ORDER BY kind", (rid, rid)).fetchall()
    if not fwd and not rev:
        print(f"no edges for '{rid}'")
        return 0
    if fwd:
        print("forward:")
        for kind, target in fwd:
            print(f"  {kind:>14}: {describe(target)}")
    if rev:
        print("reverse (what links here):")
        for kind, src in rev:
            print(f"  {kind:>14}: {describe(src)}")
    return 0


# -------------------------------------------------------------------- routes

def cmd_routes(args) -> int:
    root = kb_root()
    routes = [p for p in walk_md(root) if p.name == "_route.md"]
    nentries = 0
    chars = 0

    if args.compact:
        out: list[str] = []
        for rp in routes:
            fm, _ = parse_fm(rp)
            if fm is None:
                continue
            folder = fm.get("folder", to_kb_uri(root, rp.parent))
            out.append(f"{folder} — {first_line(fm.get('purpose'), 150)}")
            for ent in fm.get("entries") or []:
                if not isinstance(ent, dict):
                    continue
                nentries += 1
                out.append(f"  {ent.get('id')} — {first_line(ent.get('summary'), 120)}")
            out.append("")
        # recipes get their trigger line too — that's what /start matches on
        rec_dir = root / "recipes"
        if rec_dir.is_dir():
            out.append("recipe triggers (when_to_use):")
            for p in sorted(rec_dir.glob("*.md")):
                if p.name == "_route.md":
                    continue
                fm, _ = parse_fm(p)
                if fm and fm.get("type") == "recipe":
                    tag = "" if fm.get("status") == "active" else f" [{fm.get('status')}]"
                    out.append(f"  {fm.get('id')}{tag}: {first_line(fm.get('when_to_use'), 150)}")
        # models get their statement line — the ambient premises for deduction
        mdl_dir = root / "models"
        if mdl_dir.is_dir():
            stmts = []
            for p in sorted(mdl_dir.glob("*.md")):
                if p.name == "_route.md":
                    continue
                fm, _ = parse_fm(p)
                if fm and fm.get("type") == "model" and fm.get("status") != "superseded":
                    tag = f" [{fm.get('status')}]"
                    stmts.append(f"  {fm.get('id')}{tag}: {first_line(fm.get('statement'), 150)}")
            if stmts:
                out.append("")
                out.append("model statements (deductive premises — combine to derive; cite ids):")
                out.extend(stmts)
        text = "\n".join(out)
        print(text)
        chars = len(text)
        print(f"\nBASELINE: level=compact routes={len(routes)} entries={nentries} "
              f"chars={chars} est_tokens={chars // 4}")
        return 0

    for rp in routes:
        text = rp.read_text()
        chars += len(text)
        print(f"===== {to_kb_uri(root, rp)} =====")
        print(text)
        nentries += len(re.findall(r"^\s*- id:", text, re.M))

    if args.deep:
        nleaves = 0
        for p in walk_md(root):
            if p.name == "_route.md":
                continue
            text = p.read_text()
            end = text.index("\n---\n", 4) + 5 if text.startswith("---\n") and "\n---\n" in text else len(text)
            fm_text = text[:end]
            chars += len(fm_text)
            nleaves += 1
            print(f"===== {to_kb_uri(root, p)} =====")
            print(fm_text)
        print(f"BASELINE: level=deep routes={len(routes)} entries={nentries} "
              f"leaves={nleaves} chars={chars} est_tokens={chars // 4}")
    else:
        print(f"BASELINE: level=route routes={len(routes)} entries={nentries} "
              f"chars={chars} est_tokens={chars // 4}")
    return 0


# ------------------------------------------------------------ reindex-routes

def ydump(v: object) -> str:
    """One-line YAML scalar."""
    s = yaml.safe_dump(v, default_flow_style=True, allow_unicode=True,
                       width=10 ** 6).strip()
    if s.endswith("\n..."):
        s = s[: -4].strip()
    return s


def yflow(items: list) -> str:
    return "[" + ", ".join(ydump(i) for i in items) + "]"


ROUTE_KNOWN_KEYS = frozenset({"type", "folder", "title", "purpose", "last_indexed",
                              "topics", "subroutes", "entries", "related"})


def emit_route(fm: dict, body: str) -> str:
    lines = ["---", "type: route",
             f"folder: {fm['folder']}",
             f"title: {ydump(fm.get('title') or '')}",
             f"purpose: {ydump(fm.get('purpose') or '')}",
             f"last_indexed: {fm['last_indexed']}",
             f"topics: {yflow(fm.get('topics') or [])}"]
    subs = fm.get("subroutes") or []
    lines.append("subroutes:" if subs else "subroutes: []")
    for s in subs:
        lines.append(f"  - path: {s['path']}")
        lines.append(f"    summary: {ydump(s.get('summary') or '')}")
    ents = fm.get("entries") or []
    lines.append("entries:" if ents else "entries: []")
    for e in ents:
        lines.append(f"  - id: {e['id']}")
        lines.append(f"    file: {e['file']}")
        lines.append(f"    summary: {ydump(e.get('summary') or '')}")
    rel = fm.get("related") or []
    lines.append("related:" if rel else "related: []")
    for r in rel:
        lines.append(f"  - {r}")
    # round-trip anything we don't own — hand-added route metadata must survive sync
    extra = {k: v for k, v in fm.items() if k not in ROUTE_KNOWN_KEYS}
    if extra:
        lines.append(yaml.safe_dump(extra, sort_keys=False, allow_unicode=True,
                                    width=10 ** 6).strip())
    lines.append("---")
    return "\n".join(lines) + "\n" + body


def cmd_reindex_routes(args) -> int:
    root = kb_root()
    now = now_iso()
    changed = 0
    for rp in [p for p in walk_md(root) if p.name == "_route.md"]:
        fm, body = parse_fm(rp)
        if fm is None:
            print(f"kb reindex-routes: SKIP unparseable {rp}", file=sys.stderr)
            continue
        folder = rp.parent
        fm["folder"] = to_kb_uri(root, folder)

        # --- entries[]: derived from the leaves actually on disk -------------
        old_entries = {e.get("id"): e for e in (fm.get("entries") or [])
                       if isinstance(e, dict)}
        new_entries = []
        leaf_topics: list[list[str]] = []
        for leaf in sorted(folder.glob("*.md")):
            if leaf.name == "_route.md":
                continue
            lfm, _ = parse_fm(leaf)
            if lfm is None or not lfm.get("id"):
                continue
            lid = lfm["id"]
            prev = old_entries.get(lid)
            # keep the (possibly curated) one-liner; derive one for new leaves
            summary = (prev or {}).get("summary") or first_line(lfm.get("summary"), 100)
            new_entries.append({"id": lid, "file": to_kb_uri(root, leaf),
                                "summary": summary})
            leaf_topics.append([str(t) for t in (lfm.get("topics") or [])])
        # preserve curated order for kept ids, append new ones (sorted) at the end
        kept = [e for e in (fm.get("entries") or [])
                if isinstance(e, dict) and any(n["id"] == e.get("id") for n in new_entries)]
        kept_ids = {e.get("id") for e in kept}
        ordered = [next(n for n in new_entries if n["id"] == e.get("id")) for e in kept]
        ordered += [n for n in new_entries if n["id"] not in kept_ids]

        # --- subroutes: every child dir present, curated summaries kept ------
        old_subs = {s.get("path"): s for s in (fm.get("subroutes") or [])
                    if isinstance(s, dict)}
        found_subs = {}
        for child in sorted(p for p in folder.iterdir()
                            if p.is_dir() and not p.name.startswith(".")):
            child_route = child / "_route.md"
            if not child_route.is_file():
                continue
            uri = to_kb_uri(root, child_route)
            prev = old_subs.get(uri)
            if prev and prev.get("summary"):
                summary = prev["summary"]
            else:
                cfm, _ = parse_fm(child_route)
                summary = first_line((cfm or {}).get("purpose"), 100) or child.name
            found_subs[uri] = {"path": uri, "summary": summary}
        # curated order for kept paths, new children appended (sorted)
        new_subs = [found_subs[s["path"]] for s in (fm.get("subroutes") or [])
                    if isinstance(s, dict) and s.get("path") in found_subs]
        new_subs += [v for k, v in found_subs.items()
                     if k not in {s["path"] for s in new_subs}]

        # --- topics: keep existing; add tags shared by >=2 direct leaves -----
        topics = [str(t) for t in (fm.get("topics") or [])]
        counts: dict[str, int] = {}
        for ts in leaf_topics:
            for t in set(ts):
                counts[t] = counts.get(t, 0) + 1
        for t, c in sorted(counts.items()):
            if c >= 2 and t not in topics:
                topics.append(t)

        new_fm = dict(fm)
        new_fm.update(entries=ordered, subroutes=new_subs, topics=topics)
        dirty = (ordered != (fm.get("entries") or [])
                 or new_subs != (fm.get("subroutes") or [])
                 or topics != [str(t) for t in (fm.get("topics") or [])]
                 or fm.get("folder") != new_fm["folder"])
        new_fm["last_indexed"] = now if dirty else fm.get("last_indexed") or now
        out = emit_route(new_fm, body)
        if out != rp.read_text():
            changed += 1
            if args.dry_run:
                print(f"would rewrite {to_kb_uri(root, rp)}")
            else:
                rp.write_text(out)
    verb = "would rewrite" if args.dry_run else "rewrote"
    print(f"kb reindex-routes: {verb} {changed} route file(s)")
    return 0


# ---------------------------------------------------------------------- sync

def cmd_sync(args) -> int:
    rc = cmd_reindex_routes(argparse.Namespace(dry_run=False))
    audit = engine_dir() / "scripts" / "audit-topics.py"
    if audit.exists():
        r = subprocess.run(["uv", "run", "--quiet", str(audit), "--fix"],
                           capture_output=True, text=True)
        tail = (r.stdout or "").strip().splitlines()
        if tail:
            print(tail[-1])
    cmd_index(argparse.Namespace(rebuild=False, quiet=args.quiet))
    return rc


# -------------------------------------------------------------------- doctor

def cmd_doctor(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    problems = 0

    def report(kind: str, msg: str):
        nonlocal problems
        problems += 1
        print(f"  {kind:<12} {msg}")

    print("kb doctor:")
    ids = {r[0] for r in con.execute("SELECT id FROM meta WHERE id IS NOT NULL")}
    # broken bare-id references
    for src, kind, target in con.execute(
            "SELECT src, kind, target FROM edges WHERE kind != 'related'"):
        if target not in ids:
            report("broken-ref", f"{src} {kind} -> '{target}' (no such id)")
    # broken kb:/ related links
    for src, kind, target in con.execute(
            "SELECT src, kind, target FROM edges WHERE kind = 'related'"):
        if target.startswith("kb:/") and not from_kb_uri(root, target).exists():
            report("broken-link", f"{src} related -> {target} (missing on disk)")
    # recipe staleness + evidence drift
    now = datetime.now(timezone.utc)
    entry_rows = con.execute(
        "SELECT id, created, topics FROM meta WHERE doctype = 'entry' "
        "AND (status IS NULL OR status = 'active') AND id IS NOT NULL").fetchall()
    for p in walk_md(root):
        fm, _ = parse_fm(p)
        if not fm or fm.get("type") != "recipe":
            continue
        rid = fm.get("id")
        lv = fm.get("last_verified")
        # evidence drift: newer episodes in this recipe's topic area since it was
        # last looked at — its current-state claims may be outdated even if the
        # age-based check hasn't fired yet
        if fm.get("status") == "active":
            # ref = the last time anyone looked at this recipe (verified OR edited);
            # entries already folded in via derived_from are not drift
            ref = max(str(lv or ""), str(fm.get("updated") or ""),
                      str(fm.get("created") or ""))
            folded = {str(x) for x in (fm.get("derived_from") or [])}
            rtopics = {str(t) for t in (fm.get("topics") or [])}
            newer = [(eid, ec) for eid, ec, et in entry_rows
                     if ec and ec > ref and eid not in folded and len(rtopics & {
                         t.strip() for t in (et or "").split(",") if t.strip()}) >= 2]
            if newer:
                latest = max(newer, key=lambda x: x[1])[0]
                basis = "last_verified" if lv else "last update"
                report("drift-risk",
                       f"{rid}: {len(newer)} newer entr"
                       f"{'y shares' if len(newer) == 1 else 'ies share'} "
                       f"≥2 of its topics since {basis} (latest: {latest}) — "
                       f"re-verify its claims or fold the new evidence in")
        if fm.get("status") == "draft":
            created = fm.get("created") or ""
            try:
                age = (now - datetime.strptime(created, "%Y-%m-%dT%H:%M:%SZ")
                       .replace(tzinfo=timezone.utc)).days
            except ValueError:
                age = -1
            if age > 30:
                report("stale-draft", f"{rid} has been draft for {age}d — verify or drop")
        elif lv is None:
            report("unverified", f"{rid} active but last_verified is null")
        else:
            try:
                age = (now - datetime.strptime(lv, "%Y-%m-%dT%H:%M:%SZ")
                       .replace(tzinfo=timezone.utc)).days
                if age > args.recipe_max_age:
                    report("stale-recipe", f"{rid} last verified {age}d ago")
            except ValueError:
                report("bad-date", f"{rid} last_verified unparseable: {lv!r}")
    # model hygiene: the Popperian loop must not silt up
    for p in walk_md(root):
        fm, _ = parse_fm(p)
        if not fm or fm.get("type") != "model":
            continue
        mid = fm.get("id")
        status = fm.get("status")
        if status == "refuted" and not fm.get("refuted_by"):
            report("bad-model", f"{mid} refuted but refuted_by is empty")
        if status == "corroborated" and not fm.get("evidence_for"):
            report("bad-model", f"{mid} corroborated but evidence_for is empty")
        if status in ("hypothesis", "corroborated") and fm.get("refuted_by"):
            report("needs-review",
                   f"{mid} is {status} but has refuted_by evidence — refute it or narrow the statement")
        if not fm.get("derived_from"):
            report("ungrounded", f"{mid} has no derived_from — a model with no grounding episodes")
        if status == "hypothesis":
            created = fm.get("created") or ""
            try:
                age = (now - datetime.strptime(created, "%Y-%m-%dT%H:%M:%SZ")
                       .replace(tzinfo=timezone.utc)).days
            except ValueError:
                age = -1
            if age > args.model_max_age and not fm.get("evidence_for"):
                report("stale-model",
                       f"{mid} hypothesis for {age}d untested — run /criticize (rival + crucial experiment) or drop")
    # problem queue: open conflicts are where knowledge growth starts — surface, don't fix
    live = {r[0]: r[1] for r in con.execute(
        "SELECT id, status FROM meta WHERE id IS NOT NULL")}
    live_entry = {"active", None}
    for src, target in con.execute(
            "SELECT DISTINCT src, target FROM edges WHERE kind = 'contradicts'"):
        if live.get(src) in live_entry and live.get(target) in live_entry:
            report("problem",
                   f"{src} contradicts {target}, both active — unresolved conflict; "
                   f"a resolution is usually a boundary condition (/theorize)")
    live_model = {"hypothesis", "corroborated"}
    seen_pairs = set()
    for src, target in con.execute(
            "SELECT DISTINCT src, target FROM edges WHERE kind = 'rivals'"):
        pair = tuple(sorted((src, target)))
        if pair in seen_pairs:
            continue
        seen_pairs.add(pair)
        if live.get(src) in live_model and live.get(target) in live_model:
            report("problem",
                   f"{pair[0]} vs {pair[1]} — live rivals; a crucial experiment "
                   f"should kill one (/criticize proposes it)")
    # route drift: leaf on disk newer than its route's last_indexed
    for rp in [p for p in walk_md(root) if p.name == "_route.md"]:
        fm, _ = parse_fm(rp)
        if not fm:
            continue
        listed = {e.get("id") for e in (fm.get("entries") or []) if isinstance(e, dict)}
        on_disk = set()
        for leaf in rp.parent.glob("*.md"):
            if leaf.name == "_route.md":
                continue
            lfm, _ = parse_fm(leaf)
            if lfm and lfm.get("id"):
                on_disk.add(lfm["id"])
        if listed != on_disk:
            report("route-drift",
                   f"{to_kb_uri(root, rp)} entries[] != leaves on disk — run `kb sync`")
    if problems == 0:
        print("  all clear")
    return 1 if problems else 0


# ------------------------------------------------------------------ problems
#
# The epistemic ledger: kb doctor *notices* open conflicts; problem leaves under
# kb:/problems/ make them durable, with a lifecycle (open -> ready -> resolved |
# dropped). /criticize upgrades a stub to `ready` by writing the pre-registered
# crucial experiment; /run-experiment executes it and resolves. The CLI only does
# the mechanical parts: reconciling doctor findings into stubs, listing, briefing,
# and field edits at resolution time. Judgment stays with the LLM layer.

PROBLEM_AGE_FMT = "%Y-%m-%dT%H:%M:%SZ"


def problems_dir(root: Path) -> Path:
    return root / "problems"


def age_days(iso: object) -> int:
    try:
        return (datetime.now(timezone.utc)
                - datetime.strptime(str(iso), PROBLEM_AGE_FMT)
                .replace(tzinfo=timezone.utc)).days
    except ValueError:
        return -1


def load_problems(root: Path) -> list[tuple[Path, dict, str]]:
    d = problems_dir(root)
    if not d.is_dir():
        return []
    out = []
    for p in sorted(d.glob("*.md")):
        if p.name == "_route.md":
            continue
        fm, body = parse_fm(p)
        if fm and fm.get("type") == "problem":
            out.append((p, fm, body))
    return out


def write_problem(path: Path, fm: dict, body: str) -> None:
    """Fixed serializer for machine-managed problem leaves."""
    fm_text = yaml.safe_dump(fm, sort_keys=False, allow_unicode=True,
                             width=100, default_flow_style=False).strip()
    path.write_text(f"---\n{fm_text}\n---\n\n{body.strip()}\n")


def epistemic_findings(root: Path, con: sqlite3.Connection,
                       model_max_age: int = 60) -> list[dict]:
    """The doctor conditions that deserve a durable ledger entry.

    Mirrors cmd_doctor's problem/needs-review/stale-model logic; returns
    structured findings instead of printed lines.
    """
    live = {r[0]: r[1] for r in con.execute(
        "SELECT id, status FROM meta WHERE id IS NOT NULL")}
    live_model = {"hypothesis", "corroborated"}
    live_entry = {"active", None}
    findings: list[dict] = []
    rival_ids: set[str] = set()
    seen_pairs = set()
    for src, target in con.execute(
            "SELECT DISTINCT src, target FROM edges WHERE kind = 'rivals'"):
        pair = tuple(sorted((src, target)))
        if pair in seen_pairs:
            continue
        seen_pairs.add(pair)
        if live.get(pair[0]) in live_model and live.get(pair[1]) in live_model:
            rival_ids.update(pair)
            findings.append({"kind": "rivals", "ids": list(pair),
                             "fingerprint": f"rivals:{pair[0]}|{pair[1]}"})
    for src, target in con.execute(
            "SELECT DISTINCT src, target FROM edges WHERE kind = 'contradicts'"):
        pair = tuple(sorted((src, target)))
        if live.get(pair[0]) in live_entry and live.get(pair[1]) in live_entry:
            fp = f"contradiction:{pair[0]}|{pair[1]}"
            if fp not in {f["fingerprint"] for f in findings}:
                findings.append({"kind": "contradiction", "ids": list(pair),
                                 "fingerprint": fp})
    for p in walk_md(root):
        fm, _ = parse_fm(p)
        if not fm or fm.get("type") != "model":
            continue
        mid = fm.get("id")
        status = fm.get("status")
        if status in live_model and fm.get("refuted_by"):
            findings.append({"kind": "refuted-review", "ids": [mid],
                             "fingerprint": f"refuted-review:{mid}"})
        elif (status == "hypothesis" and not fm.get("evidence_for")
              and mid not in rival_ids
              and age_days(fm.get("created")) > model_max_age):
            # a lone hypothesis sitting untested — /criticize owes it a rival
            # and/or its riskiest-prediction experiment
            findings.append({"kind": "open-question", "ids": [mid],
                             "fingerprint": f"untested:{mid}"})
    return findings


def _stub_fields(root: Path, con: sqlite3.Connection, f: dict) -> tuple[str, str, str]:
    """(slug, title, body) for a scan-minted stub."""
    kind, ids = f["kind"], f["ids"]
    if kind == "rivals":
        slug = f"rivals-{ids[0]}-vs-{ids[1]}"
        title = f"{ids[0]} vs {ids[1]} — undiscriminated rivals"
    elif kind == "contradiction":
        slug = f"contradiction-{ids[0]}-vs-{ids[1]}"
        title = f"{ids[0]} contradicts {ids[1]} — unresolved"
    elif kind == "refuted-review":
        slug = f"refuted-review-{ids[0]}"
        title = f"{ids[0]} carries refutation evidence — refute or narrow"
    else:
        slug = f"untested-{ids[0]}"
        title = f"{ids[0]} is an untested lone hypothesis"
    lines = ["Minted by `kb problems scan` from a standing `kb doctor` finding.", ""]
    for i in ids:
        row = con.execute("SELECT path, status FROM meta WHERE id = ?", (i,)).fetchone()
        claim = ""
        if row:
            fm, _ = parse_fm(from_kb_uri(root, row[0]))
            claim = first_line((fm or {}).get("statement") or (fm or {}).get("summary"), 200)
        lines.append(f"- **{i}**" + (f" ({row[1]})" if row and row[1] else "") +
                     (f": {claim}" if claim else ""))
    lines += ["",
              "Next: `/criticize` designs the crucial experiment (pre-registered "
              "observation + outcomes) and upgrades this problem to `ready`; "
              "`/run-experiment` executes it."]
    return slug, title, "\n".join(lines)


def ensure_problems_route(root: Path) -> None:
    d = problems_dir(root)
    d.mkdir(exist_ok=True)
    rp = d / "_route.md"
    if rp.exists():
        return
    rp.write_text(f"""---
type: route
folder: kb:/problems
title: Problems
purpose: The epistemic ledger — open conflicts in the theory layer (undiscriminated rivals, refutation evidence, contradictions), each carrying its pre-registered crucial experiment once /criticize has designed it. Resolution is the KB's growth metric.
last_indexed: {now_iso()}
topics: []
subroutes: []
entries: []
related:
  - kb:/models/_route.md
---

# Problems

Stubs are minted deterministically by `kb problems scan` from `kb doctor` findings;
`/criticize` upgrades them to `ready` with a pre-registered experiment;
`/run-experiment` runs the observation and resolves them. Never resolve without a
filed episode as evidence.
""")


def cmd_problems(args) -> int:
    root = kb_root()
    con = ensure_index(root)
    action = args.action

    if action == "scan":
        findings = epistemic_findings(root, con, model_max_age=args.model_max_age)
        existing = {fm.get("fingerprint"): (p, fm) for p, fm, _ in load_problems(root)}
        created, inversions, cleared = 0, 0, 0
        if findings:
            ensure_problems_route(root)
        for f in findings:
            hit = existing.get(f["fingerprint"])
            if hit is None:
                slug, title, body = _stub_fields(root, con, f)
                path = problems_dir(root) / f"{slug}.md"
                if path.exists():
                    print(f"  SKIP {slug}: file exists without matching fingerprint",
                          file=sys.stderr)
                    continue
                topics: list[str] = []
                for i in f["ids"]:
                    row = con.execute("SELECT topics FROM meta WHERE id = ?", (i,)).fetchone()
                    for t in (row[0] if row else "").split(","):
                        t = t.strip()
                        if t and t not in topics and len(topics) < 8:
                            topics.append(t)
                related = []
                for i in f["ids"]:
                    row = con.execute("SELECT path FROM meta WHERE id = ?", (i,)).fetchone()
                    if row:
                        related.append(row[0])
                write_problem(path, {
                    "type": "problem", "id": slug, "title": title,
                    "created": now_iso(), "updated": now_iso(),
                    "status": "open", "kind": f["kind"],
                    "fingerprint": f["fingerprint"], "models": f["ids"],
                    "experiment": None, "resolved_by": None, "resolution": None,
                    "topics": topics, "related": related, "sources": [],
                    "summary": f"{title}. Standing doctor finding made durable; "
                               f"needs a pre-registered crucial experiment "
                               f"(/criticize), then /run-experiment.",
                }, body)
                created += 1
                print(f"  minted {slug} ({f['kind']})")
            elif hit[1].get("status") in ("resolved", "dropped"):
                inversions += 1
                print(f"  INVERSION {hit[1].get('id')}: marked "
                      f"{hit[1].get('status')} but the doctor condition still fires — "
                      f"the resolution didn't take, or edges weren't updated")
        firing = {f["fingerprint"] for f in findings}
        for p, fm, _ in load_problems(root):
            if fm.get("status") in ("open", "ready") and fm.get("fingerprint") not in firing:
                cleared += 1
                print(f"  cleared {fm.get('id')}: condition no longer fires — "
                      f"resolve it with the episode that settled it, or drop it")
        if created:
            cmd_reindex_routes(argparse.Namespace(dry_run=False))
            cmd_index(argparse.Namespace(rebuild=False, quiet=True))
        print(f"kb problems scan: {len(findings)} finding(s), {created} minted, "
              f"{inversions} inversion(s), {cleared} cleared")
        return 0

    probs = load_problems(root)

    if action == "list":
        rows = [(p, fm) for p, fm, _ in probs
                if not args.status or fm.get("status") == args.status]
        if not rows:
            print("no problems" + (f" with status {args.status}" if args.status else ""))
            return 0
        counts: dict[str, int] = {}
        for _, fm, _ in probs:
            counts[str(fm.get("status"))] = counts.get(str(fm.get("status")), 0) + 1
        for p, fm in rows:
            exp = fm.get("experiment") or {}
            extra = ""
            if fm.get("status") == "ready" and isinstance(exp, dict):
                extra = f"  [{exp.get('decisiveness', '?')}/{first_line(exp.get('cost'), 40)}]"
            if fm.get("status") == "resolved":
                extra = f"  -> {first_line(fm.get('resolution'), 60)}"
            print(f"  {fm.get('status'):<9} {age_days(fm.get('created')):>4}d  "
                  f"{fm.get('kind'):<14} {fm.get('id')}{extra}")
        print("totals: " + " · ".join(f"{v} {k}" for k, v in sorted(counts.items())))
        return 0

    if action == "brief":
        live = [(p, fm) for p, fm, _ in probs if fm.get("status") in ("open", "ready")]
        if not live:
            return 0
        ready = [(p, fm) for p, fm in live if fm.get("status") == "ready"]
        oldest = max(age_days(fm.get("created")) for _, fm in live)
        resolved_30d = sum(1 for _, fm, _ in probs
                           if fm.get("status") == "resolved"
                           and 0 <= age_days(fm.get("updated")) <= 30)
        print(f"OPEN PROBLEMS (theory layer): {len(live) - len(ready)} open · "
              f"{len(ready)} ready to run · oldest {oldest}d · "
              f"{resolved_30d} resolved in last 30d")
        for _, fm in sorted(ready, key=lambda x: age_days(x[1].get("created")),
                            reverse=True):
            exp = fm.get("experiment") or {}
            print(f"  READY {fm.get('id')} ({age_days(fm.get('created'))}d, "
                  f"{exp.get('decisiveness', '?')}/{first_line(exp.get('cost'), 40)}): "
                  f"{first_line(exp.get('observation'), 140)}")
        if ready:
            print(f"  Run one now: /run-experiment <id>")
        else:
            print("  No experiments designed yet — /criticize turns open problems "
                  "into ready ones.")
        return 0

    if action in ("resolve", "drop"):
        hits = [(p, fm, body) for p, fm, body in probs if fm.get("id") == args.id]
        if not hits:
            sys.exit(f"kb problems: no problem with id '{args.id}'")
        p, fm, body = hits[0]
        if action == "resolve":
            if not args.by:
                sys.exit("kb problems resolve: --by <episode-id> is required "
                         "(resolution without filed evidence is not resolution)")
            if not con.execute("SELECT 1 FROM meta WHERE id = ?", (args.by,)).fetchone():
                sys.exit(f"kb problems resolve: --by '{args.by}' is not a KB id")
            fm.update(status="resolved", resolved_by=args.by,
                      resolution=args.note or None, updated=now_iso())
        else:
            fm.update(status="dropped", resolution=args.note or None, updated=now_iso())
        write_problem(p, fm, body)
        cmd_index(argparse.Namespace(rebuild=False, quiet=True))
        print(f"kb problems: {fm.get('id')} -> {fm['status']}"
              + (f" (by {args.by})" if action == "resolve" else ""))
        return 0

    sys.exit(f"kb problems: unknown action {action!r}")


# ---------------------------------------------------------------------- main

def main() -> int:
    ap = argparse.ArgumentParser(prog="kb", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("index", help="build/refresh the search index")
    p.add_argument("--rebuild", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(fn=cmd_index)

    p = sub.add_parser("search", help="hybrid (BM25 + vector, RRF-fused) full-text search")
    p.add_argument("query", nargs="+")
    p.add_argument("-n", type=int, default=10, help="max hits (default 10)")
    p.add_argument("--mode", choices=["hybrid", "lexical", "vector"], default="hybrid",
                   help="hybrid falls back to lexical when no vectors exist")
    p.add_argument("--type", choices=["entry", "recipe", "model", "problem", "route", "all"], default="all")
    p.add_argument("--topic", action="append", help="require a topic tag (repeatable)")
    p.add_argument("--person", action="append", help="require a participant (repeatable)")
    p.add_argument("--all-status", action="store_true",
                   help="include superseded/archived")
    p.add_argument("--routes", action="store_true", help="include _route.md hits")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_search)

    p = sub.add_parser("eval", help="retrieval quality over the _eval.yaml gold set")
    p.add_argument("--mode", choices=["all", "hybrid", "lexical", "vector"], default="all")
    p.add_argument("--save-baseline", action="store_true",
                   help="store current MRR per mode as the regression baseline")
    p.set_defaults(fn=cmd_eval)

    p = sub.add_parser("show", help="resolve an id / kb:/ URI / path and print it")
    p.add_argument("ref")
    p.add_argument("--path", action="store_true", help="print the resolved path only")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("edges", help="typed edges for an id, forward and reverse")
    p.add_argument("id")
    p.set_defaults(fn=cmd_edges)

    p = sub.add_parser("routes", help="emit the route layer + BASELINE metrics")
    p.add_argument("--compact", action="store_true",
                   help="distilled one-line-per-entry index (for ambient injection)")
    p.add_argument("--deep", action="store_true",
                   help="also emit every leaf's frontmatter")
    p.set_defaults(fn=cmd_routes)

    p = sub.add_parser("reindex-routes",
                       help="regenerate entries[]/subroutes in every _route.md from leaves")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_reindex_routes)

    p = sub.add_parser("sync", help="reindex-routes + audit-topics --fix + index")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("problems", help="the epistemic ledger (scan/list/brief/resolve/drop)")
    p.add_argument("action", choices=["scan", "list", "brief", "resolve", "drop"])
    p.add_argument("id", nargs="?", help="problem id (resolve/drop)")
    p.add_argument("--status", help="filter (list)")
    p.add_argument("--by", help="episode id holding the evidence (resolve)")
    p.add_argument("--note", help="one-line resolution note (resolve/drop)")
    p.add_argument("--model-max-age", type=int, default=60,
                   help="days before a lone untested hypothesis becomes a problem (scan)")
    p.set_defaults(fn=cmd_problems)

    p = sub.add_parser("doctor", help="staleness + referential integrity report")
    p.add_argument("--recipe-max-age", type=int, default=90,
                   help="days before an active recipe counts as stale (default 90)")
    p.add_argument("--model-max-age", type=int, default=60,
                   help="days a hypothesis may sit unconfirmed before flagging (default 60)")
    p.set_defaults(fn=cmd_doctor)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
