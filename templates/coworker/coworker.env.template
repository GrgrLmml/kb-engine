# coworker.env — instance config for your co-worker home (read by scripts/coworker
# and scripts/slack-agent). Plain KEY=VALUE; never put tokens in here.

# Prefix for unit names (systemd: <name>-<agent>-<slot>.timer).
COWORKER_NAME=coworker

# Timezone for scheduled times on systemd, e.g. Europe/Berlin. Empty = machine time.
# (launchd on macOS always uses the machine's local time.)
COWORKER_TZ=

# KB claim prefixes injected into every run as KB FACTS (space-separated).
# Seed them first: one entry whose claims describe what you work on (docs/coworker.md).
FACTS_PREFIX=

# Where agent reports land in the KB: <KB_FOLDER>/<agent>/ (created on first run).
KB_FOLDER=kb:/coworker

# Model when an agent's frontmatter doesn't name one.
DEFAULT_MODEL=sonnet

# Slack (optional). Ids, not names: channel ids start with C, user ids with U.
SLACK_OWNER_ID=
SLACK_BOT_NAME=
SLACK_DEFAULT_CHANNEL=
SLACK_TEAM_ID=
# How scripts get the bot token at run time. The token lives only in the Claude
# CLI's MCP config (`claude mcp add slack-mcp ...`, run in SLACK_MCP_CWD).
SLACK_TOKEN_CMD="claude mcp get slack-mcp"
SLACK_MCP_CWD=

# Commit (and push, if the repo has an upstream) after every run.
SYNC_AFTER_RUN=1
SYNC_PUSH=1
